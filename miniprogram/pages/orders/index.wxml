<view class="page-shell orders-page">
  <!-- 状态条最终形态：「横着的一行、占满整行所以不需要滑」。
       关键：flex 不能挂在 scroll-view 自己身上 —— 小程序的 scroll-view 内部还有一层内容容器，
       把 display:flex 写在 scroll-view 上的话，7 个按钮落进的是那层容器，平分链会断，
       真机上就退化成"按文字宽度挤在左边"（预览里可能看不出，手机上很明显）。
       所以外面保留 scroll-view scroll-x（保住"能左右滑"的能力），里面再套一个真实的 view，
       由 .status-tabs-inner 做 flex 容器、width:100%，7 个状态 flex:1 1 0 等宽平分整行。
       当前不溢出、所以滑不动；万一以后状态变多，仍然能左右滑。 -->
  <scroll-view scroll-x class="status-tabs">
    <view class="status-tabs-inner">
      <button wx:for="{{statusTabs}}" wx:key="label" class="{{item.label === active ? 'active' : ''}}" data-status="{{item.label}}" bindtap="choose">{{item.label}}<text wx:if="{{item.hasOrders}}" class="status-dot"></text></button>
    </view>
  </scroll-view>
  <view class="order-search"><input placeholder="搜索订单" value="{{keyword}}" bindinput="search" confirm-type="search" /><button bindtap="filter">搜索</button></view>
  <scroll-view scroll-y class="order-scroll" lower-threshold="120" bindscrolltolower="loadMore" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onScrollRefresh">
  <view wx:if="{{loading && !orders.length}}" class="loading">正在同步订单状态...</view>
  <view wx:for="{{visibleOrders}}" wx:key="no" class="order surface">
    <view class="order-head">
      <text class="order-time">{{item.time}}</text>
      <text class="order-status">{{item.status}}</text>
    </view>
    <view class="order-product-row">
      <image wx:if="{{item.productImage}}" class="order-product-image" src="{{item.productImage}}" mode="aspectFill" data-no="{{item.no}}" bindtap="goGoodsDetail" />
      <view class="order-product-main">
        <text class="order-product" data-no="{{item.no}}" bindtap="goGoodsDetail">{{item.product}}</text>
        <view class="order-price-row"><text class="price">¥{{item.priceText}}</text><text class="order-quantity">×{{item.quantity}}</text></view>
        <view class="order-description" data-no="{{item.no}}" bindtap="showServiceDetail"><text>{{item.productDescription || '点击查看订单服务详情'}}</text><text class="order-description-link">详情 ›</text></view>
      </view>
    </view>
    <view class="order-fields">
      <view class="order-field order-number-field">
        <text class="order-field-label">订单编号：</text>
        <view class="order-number-wrap"><text class="order-number">{{item.no}}</text><button data-no="{{item.no}}" bindtap="copy">复制</button></view>
      </view>
      <view wx:if="{{item.gameName}}" class="order-field"><text class="order-field-label">游戏昵称：</text><text class="order-field-value">{{item.gameName}}</text></view>
      <view class="order-field"><text class="order-field-label">游戏 ID：</text><text class="order-field-value">{{item.gameId || '未填写'}}</text></view>
      <view class="order-field"><text class="order-field-label">游戏区服：</text><text class="order-field-value">{{item.server || '未填写'}}</text></view>
      <view wx:if="{{item.user}}" class="order-field"><text class="order-field-label">下单玩家：</text><text class="order-field-value">{{item.user}}</text></view>
      <view wx:if="{{item.staffId}}" class="order-field"><text class="order-field-label">接单陪玩：</text><text class="order-field-value">{{item.staff || '已接单'}}</text></view>
      <view class="order-field"><text class="order-field-label">下单备注：</text><text class="order-field-value">{{item.remark || '无'}}</text></view>
      <view wx:if="{{item.refund}}" class="order-field"><text class="order-field-label">退款原因：</text><text class="order-field-value">{{item.refund.reason}}</text></view>
    </view>
    <view class="order-paid"><text>{{item.paymentLabel}}</text><view class="order-paid-values"><text wx:if="{{item.originalText}}" class="order-original">¥{{item.originalText}}</text><text class="price">¥{{item.paymentStatus === 'pending' ? item.priceText : item.paidText}}</text></view></view>
    <view class="order-actions {{item.paymentStatus === 'pending' ? 'pending-actions' : ''}}">
      <button data-no="{{item.no}}" bindtap="openDetail">查看详情</button>
      <button wx:if="{{item.paymentStatus !== 'cancelled'}}" data-no="{{item.no}}" bindtap="openComplaint" disabled="{{cancellingNo === item.no}}">{{item.complaint ? '查看投诉' : '订单投诉'}}</button>
      <button wx:if="{{item.canChat}}" data-no="{{item.no}}" bindtap="openChat">订单聊天</button>
      <button data-id="{{item.productId}}" bindtap="buyAgain">再次购买</button>
      <button wx:if="{{item.paymentStatus === 'pending'}}" data-no="{{item.no}}" bindtap="cancelOrder" loading="{{cancellingNo === item.no}}" disabled="{{cancellingNo === item.no}}">取消订单</button>
      <button wx:if="{{item.paymentStatus === 'pending'}}" class="primary" data-no="{{item.no}}" bindtap="pay" disabled="{{cancellingNo === item.no}}">立即支付</button>
      <button wx:if="{{item.paymentStatus === 'paid' && item.lottery && item.lottery.status === 'pending'}}" class="primary" data-no="{{item.no}}" bindtap="openLottery">立即抽奖</button>
    </view>
    <button wx:if="{{item.reviewState === 'todo'}}" class="review-entry" data-no="{{item.no}}" bindtap="openReview">去评价</button>
    <button wx:elif="{{item.reviewState === 'rejected'}}" class="review-entry is-again" data-no="{{item.no}}" bindtap="openReview">重新评价</button>
    <view wx:elif="{{item.reviewState === 'pending' || item.reviewState === 'approved'}}" class="review-flag is-ok">已评价 <text class="review-stars-on">{{item.reviewStars}}</text><text class="review-stars-off">{{item.reviewStarsEmpty}}</text></view>
  </view>
  <view wx:if="{{!loading && hasMore}}" class="order-end">继续上滑，查看更多订单</view>
  <view wx:if="{{!loading && visibleOrders.length && !hasMore}}" class="order-end">没有更多了</view>
  <view wx:if="{{!loading && !visibleOrders.length}}" class="empty surface">还没有这个状态的订单</view>
  </scroll-view>
  <view wx:if="{{complaintVisible && complaintOrder}}" class="complaint-mask" bindtap="closeComplaint">
    <view class="complaint-sheet" catchtap="noop">
      <view class="complaint-head"><text>订单投诉</text><button bindtap="closeComplaint" aria-label="关闭订单投诉">×</button></view>
      <text class="complaint-order-no">订单 {{complaintOrder.no}}</text>
      <block wx:if="{{complaintOrder.complaint}}">
        <text class="complaint-state">{{complaintOrder.complaint.status === 'resolved' ? '商户已处理' : '已提交，等待商户处理'}}</text>
        <text class="complaint-content">{{complaintOrder.complaint.content}}</text>
      </block>
      <block wx:else>
        <textarea class="complaint-input" value="{{complaintText}}" bindinput="onComplaintInput" maxlength="500" placeholder="请描述订单问题（至少 5 个字）" />
        <button class="complaint-submit" bindtap="submitComplaint" loading="{{complaintSubmitting}}" disabled="{{complaintSubmitting}}">提交投诉</button>
      </block>
    </view>
  </view>
  <view wx:if="{{serviceVisible && serviceOrder}}" class="service-mask" bindtap="closeServiceDetail">
    <view class="service-sheet" catchtap="noop">
      <view class="service-head"><text>服务详情</text><button bindtap="closeServiceDetail" aria-label="关闭服务详情">×</button></view>
      <text class="service-product">{{serviceOrder.product}}</text>
      <text class="service-content">{{serviceOrder.productDescription || '该商品未配置服务说明，请以订单详情及商户说明为准。'}}</text>
      <button class="service-close" bindtap="closeServiceDetail">知道了</button>
    </view>
  </view>
  <view wx:if="{{reviewVisible && reviewOrder}}" class="review-mask" bindtap="closeReview">
    <view class="review-dialog" catchtap="noop">
      <text class="review-dialog-title">评价这条订单</text>
      <text class="review-dialog-sub">{{reviewOrder.product}}</text>
      <view class="review-rating">
        <text wx:for="{{ratingOptions}}" wx:key="*this" class="{{reviewRating >= item ? 'on' : ''}}" data-value="{{item}}" bindtap="chooseRating">★</text>
      </view>
      <textarea class="review-textarea" value="{{reviewContent}}" maxlength="300" placeholder="说说这次的服务体验吧" bindinput="onReviewInput" />
      <view class="review-dialog-actions">
        <button class="ghost" bindtap="closeReview">取消</button>
        <button class="primary" loading="{{reviewSubmitting}}" disabled="{{reviewSubmitting}}" bindtap="submitReview">提交评价</button>
      </view>
    </view>
  </view>
  <view wx:if="{{chatVisible}}" class="chat-mask" bindtap="closeChat">
    <view class="chat-sheet" catchtap="noop">
      <view class="chat-head">
        <view><text>订单聊天</text><text>{{chatOrder.no}}</text></view>
        <button bindtap="closeChat">×</button>
      </view>
      <scroll-view scroll-y class="chat-messages" scroll-into-view="chatBottom">
        <view wx:if="{{!chatMessages.length}}" class="chat-empty">还没有消息</view>
        <view wx:for="{{chatMessages}}" wx:key="id" class="chat-message {{item.isMine ? 'mine' : 'other'}}">
          <text class="sender">{{item.senderName}}</text>
          <view>{{item.body}}</view>
          <text class="read-state">{{item.isMine ? (item.read ? '已读' : '未读') : '已读'}}</text>
        </view>
        <view id="chatBottom"></view>
      </scroll-view>
      <view class="chat-form"><input value="{{chatInput}}" bindinput="onChatInput" maxlength="500" placeholder="输入消息" /><button bindtap="sendChat">发送</button></view>
    </view>
  </view>
</view>
