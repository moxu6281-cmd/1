.home-page {
  padding-bottom: 220rpx;
  background: linear-gradient(
    180deg,
    #f6f0e4 0,
    #f6f0e4 20vh,
    #fff 20vh,
    #fff 100%
  );
}
.preview-tip { margin: 0 0 18rpx; padding: 13rpx 20rpx; border: 1rpx solid #f0c761; border-radius: 12rpx; background: #fff6d8; color: #7a5b08; font-size: 21rpx; line-height: 1.4; text-align: center; }
.search-row { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.search { flex: 1; height: 88rpx; padding: 0 32rpx; border-radius: 44rpx; background: rgba(255, 255, 255, .92); box-sizing: border-box; box-shadow: 0 16rpx 36rpx rgba(31, 41, 55, .06); }
.support { flex: 0 0 92rpx; width: 92rpx; min-width: 92rpx; max-width: 92rpx; height: 88rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 44rpx; background: rgba(255, 255, 255, .92); box-shadow: 0 16rpx 36rpx rgba(31, 41, 55, .06); }
/* 客服的耳机图标已提到 app.wxss，首页搜索栏与商品详情页底部共用同一份定义，别在这里重复写。 */
.hero { position: relative; min-height: 280rpx; overflow: hidden; color: #fff; background: #063c4b; border-radius: 16rpx; }
.hero-media { display: block; width: 100%; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(4, 18, 31, .76), rgba(4, 18, 31, .18)); }
.hero-copy { position: absolute; inset: 0; z-index: 1; padding: 34rpx; display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; }
.hero:not(.has-image) .hero-copy { position: relative; min-height: 280rpx; }
.hero-eye { font-size: 24rpx; font-weight: 700; }
.hero-title { width: 84%; margin-top: 12rpx; font-size: 40rpx; line-height: 1.18; font-weight: 800; }
.hero-sub { width: 88%; margin-top: 12rpx; font-size: 23rpx; opacity: .9; }
.notice-line { margin: 18rpx 0 14rpx; padding: 15rpx 22rpx; display: flex; gap: 12rpx; align-items: center; border-radius: 30rpx; background: #ffdcd2; color: #934a3a; font-size: 22rpx; line-height: 1.35; }
.speaker { flex: 0 0 auto; color: #65a4cf; transform: rotate(180deg); }
/* 首页播报 = 老板端同款「漂浮气泡」：多个气泡叠在同一行，各自跑一条 16s 无限循环的
   漂浮动画，靠 animation-delay（页面 JS 按 0s/4s/8s/12s 错开）依次入场、停留、飘走。
   纯 CSS 动画自循环，不需要 JS 定时器反复重挂类名——这也是原来 ticker 那套 hack 被去掉的原因。 */
.live-broadcast { position: fixed; left: 24rpx; top: 44vh; z-index: 70; width: 62vw; max-width: 520rpx; height: 76rpx; pointer-events: none; }
.broadcast-pill { position: absolute; left: 0; top: 0; height: 76rpx; max-width: 100%; padding: 8rpx 30rpx 8rpx 10rpx; display: flex; align-items: center; gap: 14rpx; box-sizing: border-box; border: 1rpx solid rgba(59,168,182,.4); border-radius: 40rpx; background: linear-gradient(90deg, rgba(220,246,248,.96), rgba(235,245,255,.94)); color: #284a5b; box-shadow: 0 12rpx 28rpx rgba(35,112,127,.16); font-size: 23rpx; line-height: 1.25; white-space: nowrap; overflow: hidden; opacity: 0; animation: broadcastFloat 16s ease-in-out infinite; will-change: transform, opacity; }
.broadcast-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.broadcast-avatar { position: relative; width: 52rpx; height: 52rpx; flex: 0 0 52rpx; overflow: hidden; border-radius: 50%; background: #eef2f5; border: 1rpx solid rgba(89,105,122,.18); }
.blank-avatar-head { position: absolute; left: 50%; top: 10rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #9aa6b2; transform: translateX(-50%); }
.blank-avatar-body { position: absolute; left: 50%; bottom: 6rpx; width: 30rpx; height: 17rpx; border-radius: 18rpx 18rpx 8rpx 8rpx; background: #9aa6b2; transform: translateX(-50%); }
@keyframes broadcastFloat {
  0% { opacity: 0; transform: translate3d(-24rpx, 10rpx, 0) scale(.96); }
  7% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  22% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  30% { opacity: 0; transform: translate3d(16rpx, -10rpx, 0) scale(.98); }
  100% { opacity: 0; transform: translate3d(16rpx, -10rpx, 0) scale(.98); }
}
.notice-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin: 16rpx 0; }
.notice-links button { width: 100%; min-width: 0; padding: 18rpx 14rpx; text-align: left; background: linear-gradient(135deg, #fff0b8, #fff7d9); border-radius: 12rpx; line-height: 1.35; overflow: hidden; }
.notice-links text { display: block; min-width: 0; font-size: 24rpx; font-weight: 700; white-space: normal; overflow-wrap: anywhere; }
.notice-links .small { color: #866a1c; font-size: 20rpx; font-weight: 400; }
.home-category-panel { margin: 22rpx 0 26rpx; padding: 20rpx 16rpx 6rpx; border: 1rpx solid #eef2f6; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(48, 84, 105, .05); box-sizing: border-box; }
.category-grid { display: flex; flex-wrap: wrap; justify-content: center; margin: 0; padding: 0; box-sizing: border-box; }
.category { width: 25%; min-width: 0; max-width: 25%; margin: 0 0 14rpx; padding: 0 6rpx; background: transparent; box-sizing: border-box; overflow: visible; transition: transform .16s ease; }
.category-card { width: 100%; min-height: 178rpx; padding: 20rpx 6rpx 18rpx; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; background: #fff; border: 1rpx solid #f0f4f8; border-radius: 26rpx; color: #44546a; font-size: 22rpx; font-weight: 600; line-height: 1.3; box-sizing: border-box; overflow: hidden; transition: color .18s ease, background .18s ease, border-color .18s ease, box-shadow .18s ease; }
.category.active .category-card { color: #0a4f68; font-weight: 700; background: linear-gradient(170deg, #f2fbff, #fff); border-color: #93d6ef; box-shadow: 0 10rpx 22rpx rgba(63, 184, 224, .16); }
.category-pressed { transform: scale(.96); }
.category image, .category-fallback { width: 96rpx; height: 96rpx; margin: 0 auto 14rpx; border-radius: 28rpx; box-shadow: 0 8rpx 18rpx rgba(24, 38, 54, .14); box-sizing: border-box; flex: 0 0 96rpx; transition: box-shadow .18s ease; }
.category.active image, .category.active .category-fallback { box-shadow: 0 0 0 4rpx rgba(67, 193, 233, .28), 0 10rpx 20rpx rgba(24, 38, 54, .16); }
.category-fallback { display: flex; align-items: center; justify-content: center; background: linear-gradient(158deg, #26364a, #16202e); color: #fff; font-size: 36rpx; font-weight: 800; }
.category.active .category-fallback { background: linear-gradient(158deg, #34aad6, #1c7ba4); }
.category text { display: block; width: 100%; padding: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center; box-sizing: border-box; }
.sub-tabs { width: 100%; white-space: nowrap; margin: 18rpx 0 0; padding: 2rpx 0 4rpx; }
.sub-tabs button { display: inline-block; min-height: 58rpx; margin-right: 12rpx; padding: 10rpx 24rpx; border: 1rpx solid #dbe8ef; border-radius: 29rpx; background: #f5f7f8; color: #6c7684; font-size: 22rpx; line-height: 1.55; }
.sub-tabs button.active { background: linear-gradient(135deg, #43c1e9, #73d3ee); color: #fff; font-weight: 700; box-shadow: 0 10rpx 20rpx rgba(63, 184, 224, .18); }
.sub-tab-pressed { opacity: .78; }
/* Grid instead of flex + hand-computed widths: an incomplete last row always starts at
   column 1 (left aligned with the first column) and can never be centred or stretched. */
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22rpx; width: 100%; margin: 0; box-sizing: border-box; justify-content: start; align-content: start; justify-items: stretch; }
.product-grid.columns-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
.product-grid.columns-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.product-grid.columns-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.product-grid.columns-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
/* width:100% keeps the card filling its own cell and `margin: 0 !important` overrides the
   mini program's built-in `button { margin-left: auto; margin-right: auto }`; together
   they leave no free space, so a lone leftover card can never be centred. */
.product-grid .product-shell { width: 100%; min-width: 0; margin: 0 !important; padding: 0; background: transparent; text-align: left; box-sizing: border-box; overflow: visible; }
.product-shell { min-width: 0; margin: 0; padding: 0; background: transparent; text-align: left; box-sizing: border-box; overflow: visible; }
.product-card { width: 100%; height: 100%; min-width: 0; padding: 0; overflow: hidden; text-align: left; background: rgba(255,255,255,.96); border: 1rpx solid #e1e8ee; border-radius: 18rpx; box-shadow: 0 10rpx 24rpx rgba(40,62,80,.07); box-sizing: border-box; }
.product-image { position: relative; aspect-ratio: 1 / 1; background: #f0f4f7; }
.product-image image { width: 100%; height: 100%; }
.product-fallback { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #064d45, #07856f); color: #fff; font-weight: 700; }
.product-body { padding: 20rpx; }
.product-title { display: -webkit-box; min-height: 68rpx; font-size: 27rpx; line-height: 1.25; font-weight: 700; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.product-desc { display: -webkit-box; height: 64rpx; margin: 10rpx 0; color: #7a8798; font-size: 21rpx; line-height: 1.5; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.product-meta { display: flex; justify-content: space-between; align-items: flex-end; gap: 8rpx; color: #8b95a5; font-size: 19rpx; }
.product-meta .price { font-size: 30rpx; }.old-price { margin-left: 7rpx; color: #9ca5b3; font-size: 18rpx; text-decoration: line-through; }
.product-grid.columns-2 .product-body { padding: 22rpx 20rpx 24rpx; }
.product-grid.columns-2 .product-title { min-height: 72rpx; line-height: 1.32; }
.product-grid.columns-2 .product-desc { height: 68rpx; margin: 12rpx 0 14rpx; }
.product-grid.columns-2 .product-meta { display: block; }
.product-grid.columns-2 .product-meta > text { display: block; margin-top: 9rpx; }
.product-grid.compact .product-body { padding: 11rpx; }.product-grid.compact .product-title { min-height: 55rpx; font-size: 22rpx; }.product-grid.compact .product-desc { height: 50rpx; font-size: 18rpx; }.product-grid.compact .product-meta { display: block; }.product-grid.compact .product-meta > text { display: block; margin-top: 5rpx; }.product-grid.compact .product-meta .price { font-size: 24rpx; }
.product-grid.ultra-compact { gap: 10rpx; }.product-grid.ultra-compact .product-body { padding: 8rpx; }.product-grid.ultra-compact .product-title { min-height: 44rpx; font-size: 18rpx; }.product-grid.ultra-compact .product-desc { display: none; }.product-grid.ultra-compact .old-price { display: none; }
.mask { position: fixed; inset: 0; z-index: 99; display: flex; align-items: center; justify-content: center; padding: 42rpx; background: rgba(15, 23, 42, .5); box-sizing: border-box; }
.notice-modal, .category-modal { position: relative; width: 100%; max-height: 76vh; padding: 38rpx; border-radius: 18rpx; background: #fff; box-sizing: border-box; }
.notice-modal { max-height: 78vh; padding: 0; overflow: hidden; border-radius: 34rpx; text-align: center; box-shadow: 0 36rpx 90rpx rgba(15, 23, 42, .26); animation: categoryChoiceIn .22s ease both; }
.category-modal { padding: 24rpx; max-height: 84vh; overflow-y: auto; border-radius: 36rpx; box-shadow: 0 36rpx 80rpx rgba(15, 23, 42, .24); animation: categoryChoiceIn .22s ease both; }
.close { position: absolute; right: 18rpx; top: 16rpx; z-index: 2; width: 58rpx; height: 58rpx; padding: 0; border-radius: 50%; background: #eef2f6; color: #66758a; font-size: 38rpx; line-height: 54rpx; }
.notice-kicker, .notice-title { display: block; }
.notice-kicker { padding: 26rpx 78rpx 8rpx; color: #111827; font-size: 26rpx; font-weight: 800; }
.notice-article { height: 50vh; max-height: 720rpx; padding: 10rpx 34rpx 24rpx; box-sizing: border-box; }
.notice-title { margin: 6rpx 0 18rpx; color: #111827; font-size: 38rpx; font-weight: 800; line-height: 1.3; }
.notice-content { display: block; margin: 0; font-weight: 600; line-height: 1.72; text-align: left; white-space: pre-wrap; }
.notice-banner { min-height: 104rpx; margin-top: 20rpx; padding: 20rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: #fff; font-size: 27rpx; font-weight: 800; line-height: 1.4; box-sizing: border-box; }
.notice-footer { border-top: 1rpx solid #e5e7eb; }
.notice-footer button { width: 100%; height: 82rpx; margin: 0; padding: 0; border-radius: 0; background: #fff; color: #545b66; font-size: 26rpx; line-height: 82rpx; }
/* 顶栏的「选择大分类」标签已按用户 2026-09-15 要求删除：它和下面居中的标题「陛下想玩什么？」重复，
   删掉后弹窗第一行就是标题，视觉更紧凑。小程序端不再有 .category-modal-head 这个节点，
   × 直接挂在 .category-modal 上（本来就是绝对定位，位置不变）。
   注意：网页端那一行还留着，这里是**有意不对称** —— 别照着网页端把它同步回来，
   check-miniprogram.js 里有断言会当场拦住。 */
.category-close { position: absolute; top: 24rpx; right: 24rpx; z-index: 2; display: flex; align-items: center; justify-content: center; width: 52rpx; min-width: 52rpx; max-width: 52rpx; height: 52rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: #f1f5f9; color: #64748b; font-size: 36rpx; font-weight: 400; line-height: 1; box-sizing: border-box; }
.category-close::after { display: none; }
.category-modal-title { display: block; margin-top: 8rpx; margin-bottom: 4rpx; color: #0f172a; font-size: 32rpx; font-weight: 800; line-height: 1.3; text-align: center; }
/* 说明那行「选择后会直接跳到对应分类，下面只展示这个大类的订单。」已按用户 2026-09-15 要求删除
   （小程序端）。删掉后标题会和卡片区贴在一起，所以卡片区补 16rpx 上边距回一点呼吸感 ——
   留意 margin 折叠：标题的 margin-bottom 4rpx 与这里的 16rpx 折叠成 16rpx，别再往上加。
   网页端还留着那一行，这里是**有意不对称**，别照着网页端同步回来（check-miniprogram 会拦）。 */
.category-choice-grid { display: flex; flex-wrap: wrap; width: calc(100% + 16rpx); margin: 16rpx -8rpx -8rpx; box-sizing: border-box; }
.category-choice-shell { width: 50%; min-width: 0; padding: 8rpx; box-sizing: border-box; }
.category-choice { width: 100%; min-width: 0; max-width: 100%; min-height: 104rpx; margin: 0; padding: 16rpx; text-align: left; background: linear-gradient(135deg, #e0f2fe, #fff7d6); border: 1rpx solid #bee3f8; border-radius: 24rpx; box-sizing: border-box; }
/* 分类图片：与网页端 .category-choice-grid img 严格 2 倍镜像（48px→96rpx），mode="aspectFill" 对应 object-fit:cover。
   没配图的分类用 wx:if 直接不渲染（和网页端一致），这样"没图"的商户弹窗仍是紧凑的。 */
.category-choice image { display: block; width: 100%; height: 96rpx; margin-bottom: 12rpx; border-radius: 16rpx; }
.category-choice text { display: block; max-width: 100%; color: #0f3f64; font-size: 28rpx; font-weight: 800; line-height: 1.25; white-space: normal; word-break: break-all; }
.category-choice .small { margin-top: 8rpx; color: #64748b; font-size: 22rpx; font-weight: 400; }
@keyframes categoryChoiceIn { from { opacity: 0; transform: translateY(28rpx) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
.retry { margin-top: 20rpx; background: #0b8f7b; color: #fff; }
