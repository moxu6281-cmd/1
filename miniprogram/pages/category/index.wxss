/* 分类页样式：按「分类页面-复刻提示词.md」§5.3 一比一还原（逐条保留，不改尺寸/圆角/间距）。
   唯一的颜色改动：把参考页的红珊瑚(#ff6b6b/#ee5a5a)与蓝紫渐变按钮(#8ec5fc→#c183ff)
   换成本项目统一的橙色体系（#ff8800 / #ffad20→#ff8a00），见 AGENTS.md §6。 */
.clf-page{background:linear-gradient(180deg,#fff 0%,#f8fbff 44%,#fffaf0 100%);min-height:100vh;touch-action:pan-y}
.clf-box,.clf-page{box-sizing:border-box;overflow-x:hidden;width:100%}
.clf-box{padding-bottom:50rpx;padding-top:0}
.clf-box,.clf-nav-bar{background:transparent;position:relative}
/* ⚠️ box-sizing:content-box 是必须的：app.wxss 里全局给 view 定了 border-box，
   不显式改回来的话 height:88rpx 会连同 padding 一起算成 88rpx，
   标题栏总占位从 208rpx 塌成 88rpx（提示词 §八.4 专门警告过这一点）。 */
.clf-nav-bar{box-sizing:content-box;-webkit-align-items:center;align-items:center;border-bottom:1rpx solid rgba(0,0,0,.06);display:-webkit-flex;display:flex;height:88rpx;-webkit-justify-content:center;justify-content:center;padding:60rpx 24rpx;z-index:1}
.clf-nav-title{color:#000;font-size:42rpx;font-weight:600;text-align:center}
/* 下面 3 组是参考页 WXSS 里的「遗留样式」（.clf-tabs-wrap / .clf-tab-* / .clf-category-scroll），
   当年顶部「商品 / 排行榜」胶囊切换条被删掉后没清干净，WXML 里完全没有用到（提示词 §八.2）。
   保留是为了和 §5.3 逐条对齐；**不要**据此去补 UI。 */
.clf-tabs-wrap{-webkit-align-items:stretch;align-items:stretch;-webkit-backdrop-filter:blur(10rpx);backdrop-filter:blur(10rpx);background:hsla(0,0%,100%,.8);border-radius:60rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.1);-webkit-flex-direction:row;flex-direction:row;margin:0 24rpx;padding:10rpx}
.clf-tab-item,.clf-tabs-wrap{display:-webkit-flex;display:flex}
.clf-tab-item{-webkit-align-items:center;align-items:center;background:transparent;border-radius:50rpx;-webkit-flex:1;flex:1;-webkit-justify-content:center;justify-content:center;margin:0 4rpx;padding:20rpx 0}
.clf-tab-active{background:linear-gradient(135deg,#ffad20,#ff8a00)!important;box-shadow:0 2rpx 10rpx rgba(255,138,0,.3)}
.clf-tab-text{color:#999;font-size:34rpx;font-weight:500}
.clf-tab-active .clf-tab-text{color:#fff!important;font-weight:600}
.clf-content{display:-webkit-flex;display:flex;-webkit-flex:1;flex:1;-webkit-flex-direction:row;flex-direction:row;overflow-x:hidden;padding:0}
.clf-sidebar{background:#fff;-webkit-flex-shrink:0;flex-shrink:0;overflow-x:hidden;overflow-y:auto;padding:0 0 20rpx;width:170rpx}
.clf-sidebar-item{-webkit-align-items:center;align-items:center;background:#f5f6f9;display:-webkit-flex;display:flex;-webkit-justify-content:center;justify-content:center;margin-bottom:4rpx;padding:24rpx 16rpx;position:relative;transition:all .3s ease}
.clf-sidebar-active{background:linear-gradient(135deg,#ffad20,#ff8a00);border-radius:16rpx;margin-left:8rpx;margin-right:8rpx;padding:24rpx 10rpx}
.clf-sidebar-text{color:#666;font-size:28rpx;font-weight:500;line-height:1.4;text-align:center}
.clf-sidebar-active .clf-sidebar-text{color:#fff;font-weight:500}
.clf-main{box-sizing:border-box;-webkit-flex:1;flex:1;overflow-x:hidden;overflow-y:auto;padding:0 24rpx 80rpx;width:100%}
.skeleton-sidebar{padding:20rpx 0}
.skeleton-sidebar-item{-webkit-animation:skeleton-loading 1.5s ease-in-out infinite;animation:skeleton-loading 1.5s ease-in-out infinite;background:linear-gradient(90deg,#f0f0f0 25%,#e0e0e0 50%,#f0f0f0 75%);background-size:200% 100%;border-radius:8rpx;height:88rpx;margin-bottom:4rpx}
.skeleton-card,.skeleton-list{padding:20rpx 0}
.skeleton-card{border-bottom:1rpx solid #f0f0f0;display:-webkit-flex;display:flex}
.skeleton-thumb{-webkit-animation:skeleton-loading 1.5s ease-in-out infinite;animation:skeleton-loading 1.5s ease-in-out infinite;background:linear-gradient(90deg,#f0f0f0 25%,#e0e0e0 50%,#f0f0f0 75%);background-size:200% 100%;border-radius:12rpx;height:160rpx;width:160rpx}
.skeleton-info{display:-webkit-flex;display:flex;-webkit-flex:1;flex:1;-webkit-flex-direction:column;flex-direction:column;-webkit-justify-content:space-between;justify-content:space-between;margin-left:20rpx}
.skeleton-title{height:40rpx;width:80%}
.skeleton-sales,.skeleton-title{-webkit-animation:skeleton-loading 1.5s ease-in-out infinite;animation:skeleton-loading 1.5s ease-in-out infinite;background:linear-gradient(90deg,#f0f0f0 25%,#e0e0e0 50%,#f0f0f0 75%);background-size:200% 100%;border-radius:8rpx}
.skeleton-sales{height:32rpx;width:60%}
.skeleton-bottom{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-justify-content:space-between;justify-content:space-between}
.skeleton-price{border-radius:8rpx;height:40rpx;width:30%}
.skeleton-btn,.skeleton-price{-webkit-animation:skeleton-loading 1.5s ease-in-out infinite;animation:skeleton-loading 1.5s ease-in-out infinite;background:linear-gradient(90deg,#f0f0f0 25%,#e0e0e0 50%,#f0f0f0 75%);background-size:200% 100%}
.skeleton-btn{border-radius:24rpx;height:48rpx;width:140rpx}
@-webkit-keyframes skeleton-loading{0%{background-position:200% 0}
100%{background-position:-200% 0}
}@keyframes skeleton-loading{0%{background-position:200% 0}
100%{background-position:-200% 0}
}.debug-info{background:rgba(0,0,0,.1);border-radius:8rpx;color:#000;font-size:24rpx;margin-bottom:20rpx;padding:10rpx 20rpx}
.clf-product-list,.rank-list{box-sizing:border-box;overflow-x:hidden;padding-bottom:24rpx;width:100%}
.clf-product-card{-webkit-align-items:center;align-items:center;background:#fff;border-radius:16rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,.04);box-sizing:border-box;display:-webkit-flex;display:flex;-webkit-flex-direction:row;flex-direction:row;gap:24rpx;height:220rpx;margin-bottom:24rpx;overflow:hidden;padding:24rpx;width:100%}
.clf-product-left,.clf-product-thumb{-webkit-flex-shrink:0;flex-shrink:0}
.clf-product-thumb{background:#f0f0f0;border-radius:16rpx;height:170rpx;width:170rpx}
.clf-product-right{display:-webkit-flex;display:flex;-webkit-flex:1;flex:1;-webkit-flex-direction:column;flex-direction:column;gap:8rpx;height:100%;-webkit-justify-content:space-between;justify-content:space-between;min-width:0}
.clf-product-title{-webkit-line-clamp:2;-webkit-box-orient:vertical;color:#000;display:-webkit-box;font-size:30rpx;font-weight:700;line-height:1.4;min-height:84rpx;overflow:hidden;text-overflow:ellipsis}
.clf-product-sales{color:#999;-webkit-flex-shrink:0;flex-shrink:0;font-size:26rpx}
.clf-product-bottom{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-flex-direction:row;flex-direction:row;-webkit-flex-shrink:0;flex-shrink:0;-webkit-justify-content:space-between;justify-content:space-between}
.clf-product-price{color:#e43d34;-webkit-flex-shrink:0;flex-shrink:0;font-size:24rpx;font-weight:800;margin-right:8rpx}
/* ⚠️ 宽高四道封印：小程序内置 button 自带定宽（约 368rpx），在 flex 行里 min-width:auto
   会解析成 min-content，只写 width 压不住，按钮会被撑成一条长条（AGENTS.md §7 踩过同款）。 */
.clf-product-btn{background:linear-gradient(135deg,#ffad20,#ff8a00);border:none;border-radius:10rpx;color:#fff;-webkit-flex-shrink:0;flex-shrink:0;font-size:22rpx;font-weight:700;height:48rpx;min-height:48rpx;max-height:48rpx;width:100rpx;min-width:100rpx;max-width:100rpx;-webkit-justify-content:center;justify-content:center;line-height:48rpx;margin:0;padding:0;text-align:center}
.clf-product-btn,.rank-item{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex}
.rank-item{background:#fff;border-radius:16rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,.04);-webkit-flex-direction:row;flex-direction:row;gap:20rpx;margin-bottom:24rpx;padding:24rpx}
.rank-num{-webkit-align-items:center;align-items:center;background:#ddd;border-radius:12rpx;color:#fff;display:-webkit-flex;display:flex;-webkit-flex-shrink:0;flex-shrink:0;font-size:28rpx;font-weight:800;height:56rpx;-webkit-justify-content:center;justify-content:center;width:56rpx}
.rank-1{background:linear-gradient(135deg,gold,#fa0)}
.rank-2{background:linear-gradient(135deg,silver,#a0a0a0)}
.rank-3{background:linear-gradient(135deg,#cd7f32,sienna)}
.rank-thumb{background:#f0f0f0;border-radius:12rpx;-webkit-flex-shrink:0;flex-shrink:0;height:120rpx;width:120rpx}
.rank-info{display:-webkit-flex;display:flex;-webkit-flex:1;flex:1;-webkit-flex-direction:column;flex-direction:column;gap:12rpx;min-width:0}
.rank-title{color:#000;font-size:30rpx;font-weight:700;line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rank-bottom{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-flex-direction:row;flex-direction:row;-webkit-justify-content:space-between;justify-content:space-between}
.rank-sales{color:#999;font-size:24rpx}
.rank-price{color:#e43d34;font-size:36rpx;font-weight:800}
.clf-category-section{padding:20rpx 0;width:100%}
.clf-category-scroll{white-space:nowrap;width:100%}
.clf-category-grid{box-sizing:border-box;-webkit-flex-wrap:wrap;flex-wrap:wrap;gap:20rpx;padding:0 20rpx;width:100%}
.clf-category-grid,.clf-category-item{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex}
.clf-category-item{-webkit-flex-direction:column;flex-direction:column;-webkit-flex-shrink:0;flex-shrink:0;width:calc((100% - 60rpx) / 4)}
.clf-category-image-wrap{-webkit-align-items:center;align-items:center;background:#f2f3f5;border-radius:50%;display:-webkit-flex;display:flex;height:130rpx;-webkit-justify-content:center;justify-content:center;overflow:hidden;width:130rpx}
.clf-category-image-wrap .clf-category-image{border-radius:50%;height:100rpx;width:100rpx}
.clf-category-image-active{-webkit-align-items:center;align-items:center;background:#fff;border:4rpx solid #ff8800;border-radius:50%;display:-webkit-flex;display:flex;height:130rpx;-webkit-justify-content:center;justify-content:center;overflow:hidden;width:130rpx}
.clf-category-image-active .clf-category-image{border:3rpx solid #fff;border-radius:50%;height:100rpx;width:100rpx}
/* 大分类没上传图标时的兜底：显示名字首字（原分类页就有这个行为，保留，避免出现空白圆圈） */
.clf-category-fallback{-webkit-align-items:center;align-items:center;background:#e8edf2;border-radius:50%;color:#5b6a7d;display:-webkit-flex;display:flex;font-size:44rpx;font-weight:700;height:100rpx;-webkit-justify-content:center;justify-content:center;width:100rpx}
.clf-category-image-active .clf-category-fallback{border:3rpx solid #fff;height:100rpx;width:100rpx}
.clf-category-name-wrap{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;height:50rpx;-webkit-justify-content:center;justify-content:center;margin-top:15rpx;width:100%}
.clf-category-name{color:#000;font-size:26rpx;overflow:hidden;text-align:center;text-overflow:ellipsis;white-space:nowrap}
.clf-category-active .clf-category-name{background:linear-gradient(135deg,#ffad20,#ff8a00);border-radius:20rpx;color:#fff;padding:4rpx 16rpx}
.clf-category-title{margin-bottom:10rpx;padding:10rpx 0;width:100%}
.clf-category-title-text{color:#000;font-size:32rpx;font-weight:700;padding-left:20rpx}
/* 商品 / 榜单没图时的兜底（原分类页的「暂无图片」行为，保留） */
.clf-product-thumb-fallback{-webkit-align-items:center;align-items:center;color:#8a95a5;display:-webkit-flex;display:flex;font-size:22rpx;-webkit-justify-content:center;justify-content:center}
.rank-thumb-fallback{-webkit-align-items:center;align-items:center;color:#8a95a5;display:-webkit-flex;display:flex;font-size:22rpx;-webkit-justify-content:center;justify-content:center}
