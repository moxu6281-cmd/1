:host { display: block; }
.panel-page { padding: 0 24rpx 32rpx; color: #333; font-size: 26rpx; line-height: 1.8; }
.panel-page view,.panel-page text,.panel-page button,.panel-page input { box-sizing: border-box; }
.panel-page button { width: auto; min-width: 0; max-width: 100%; margin: 0; border: none; padding: 12rpx 20rpx; border-radius: 16rpx; color: #a94f0a; background: #fff0dc; font-size: 24rpx; line-height: 1.6; }
.panel-page button::after { border: none; }
.panel-page button[disabled] { color: #956843; background: #f5e5d5; opacity: .8; }
.panel-page .button-hover { opacity: .75; }
.navbar { padding: 28rpx 0; text-align: center; }
.navbar-title { color: #333; font-size: 34rpx; font-weight: 600; }
.integration-notice { display: flex; flex-direction: column; gap: 6rpx; padding: 20rpx 24rpx; border: 1rpx solid #edc69b; border-radius: 16rpx; background: #fff5e7; color: #9a5316; margin-bottom: 24rpx; font-size: 23rpx; }
.integration-notice text:first-child { font-size: 26rpx; font-weight: 600; }
.section,.card { background: #fff; border-radius: 24rpx; box-shadow: 0 2rpx 20rpx rgba(0,0,0,.04); padding: 28rpx; margin-bottom: 24rpx; }
.card-glass { background: rgba(255,255,255,.7); border: 1rpx solid rgba(255,255,255,.9); }
.section-title { color: #090b08; display: block; font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; }
.section-header,.auth-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.section-header .section-title,.auth-header .section-title { margin-bottom: 0; }
.auth-status-badge { border-radius: 20rpx; font-size: 22rpx; padding: 8rpx 20rpx; }
.auth-status-active { background: #eff8e8; color: #508628; }
.auth-status-inactive { background: #f6f6f6; color: #999; }
.auth-detail { display: flex; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid #eee; padding: 16rpx 0; }
.auth-label { color: #666; flex-shrink: 0; }
.auth-value { text-align: right; overflow-wrap: anywhere; }
.muted-note { display: block; color: #888; font-size: 24rpx; line-height: 1.8; padding: 16rpx 0; }
.panel-page .outline-button { border: 1rpx solid #edbf8d; background: #fff8ef; margin-top: 20rpx; }
.manager-actions { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; padding: 20rpx 0; }
.manager-actions button { width: 100%; min-width: 0; max-width: 100%; min-height: 88rpx; }
/* 管事：我的邀请码 + 下级列表（真实数据，不是占位） */
.steward-code-row { padding: 8rpx 0 4rpx; }
.steward-code { display: block; color: #c56416; font-size: 40rpx; font-weight: 700; letter-spacing: 6rpx; padding: 12rpx 0; }
.subordinate-list { display: flex; flex-direction: column; gap: 16rpx; }
.subordinate-row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 22rpx 24rpx; background: #fffaf4; border: 1rpx solid #f2e3d0; border-radius: 16rpx; }
.subordinate-name { display: block; color: #333; font-size: 28rpx; font-weight: 600; }
.subordinate-id, .subordinate-code { color: #a96228; font-size: 24rpx; }
.panel-page .wide-button { width: 100%; min-height: 88rpx; background: #ff8800; color: #fff; }
.panel-page .text-link { background: transparent; padding: 0; color: #c56416; font-size: 24rpx; }
.bill-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24rpx 12rpx; }
.panel-page .bill-item { width: 100%; min-width: 0; max-width: 100%; background: transparent; padding: 8rpx 0; text-align: left; }
.bill-num { display: block; color: #333; font-size: 32rpx; font-weight: 700; }
.bill-label { display: block; color: #a96228; font-size: 24rpx; margin-top: 12rpx; }
.level-info-row { margin-bottom: 16rpx; color: #666; }
.card-title { display: block; border-bottom: 1rpx solid rgba(0,0,0,.08); color: #000; font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; padding-bottom: 20rpx; }
.amount-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.balance-hint { color: #666; font-size: 26rpx; }
.amount-input-wrap { display: flex; align-items: center; height: 96rpx; padding: 0 24rpx; border-radius: 16rpx; background: rgba(0,0,0,.05); margin-bottom: 24rpx; }
.amount-symbol { color: #000; font-size: 40rpx; font-weight: 700; margin-right: 12rpx; }
.amount-input { flex: 1; width: 0; min-width: 0; height: 96rpx; font-size: 32rpx; }
.min-amount-tip { color: #b36b10; font-size: 24rpx; margin-bottom: 24rpx; }
.commission-detail { background: linear-gradient(135deg,#fef3e8,#fff7f0); border: 1rpx solid rgba(230,130,30,.2); border-radius: 16rpx; margin-bottom: 20rpx; padding: 20rpx 24rpx; }
.commission-row { display: flex; justify-content: space-between; align-items: center; padding: 6rpx 0; color: #8b6914; }
.actual-row { border-top: 1rpx dashed rgba(230,130,30,.25); margin-top: 8rpx; padding-top: 12rpx; }
.actual-value { color: #547b31; font-size: 30rpx; }
.card-actions { display: flex; gap: 12rpx; border-top: 1rpx solid rgba(0,0,0,.08); padding-top: 16rpx; }
.card-actions button { flex: 1; width: 0; min-height: 64rpx; font-size: 24rpx; }
.option-row { display: flex; align-items: center; gap: 20rpx; border-bottom: 1rpx solid rgba(0,0,0,.06); padding: 24rpx 0; }
.option-row:last-child { border: 0; }
.option-label { flex: 1; font-size: 28rpx; }
.option-closed { font-size: 24rpx; color: #999; }
.option-radio { width: 40rpx; height: 40rpx; border: 2rpx solid #ddd; border-radius: 50%; }
.panel-page .btn-submit { width: 100%; min-height: 88rpx; font-size: 30rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; }
.withdraw-notice-card { margin-top: 24rpx; }
.withdraw-notice-title { display: flex; align-items: center; font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; }
.withdraw-notice-accent { width: 8rpx; height: 36rpx; margin-right: 16rpx; border-radius: 8rpx; background: #ff8800; }
.withdraw-notice-text { font-size: 27rpx; color: #666; line-height: 1.9; }
.balance-row { display: flex; align-items: center; gap: 12rpx; }
.balance-label { color: #666; font-size: 28rpx; }
.balance-num { color: #000; font-size: 36rpx; font-weight: 700; }
.balance-unit { color: #666; font-size: 26rpx; }
.amount-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 24rpx; }
.panel-page .amount-item { width: 100%; min-width: 0; max-width: 100%; padding: 32rpx 24rpx; border-radius: 20rpx; }
.amount-value { display: block; font-size: 32rpx; font-weight: 700; margin-bottom: 8rpx; }
.amount-desc { font-size: 24rpx; }
.tabs-wrap,.tabs-row { display: flex; gap: 12rpx; border-radius: 16rpx; padding: 16rpx; background: #fff; margin-bottom: 24rpx; }
.panel-page .tab-item,.panel-page .method-tab { flex: 1; width: 0; min-width: 0; max-width: 100%; padding: 16rpx 0; font-size: 24rpx; white-space: nowrap; }
.panel-page .tab-item.active,.panel-page .method-tab.active { background: #ff8800; color: #fff; }
.form-row { border-bottom: 1rpx solid #eee; padding-bottom: 24rpx; margin-bottom: 24rpx; }
.form-label { display: block; font-size: 24rpx; margin-bottom: 16rpx; color: #333; }
.form-input { width: 100%; height: 80rpx; padding: 0 24rpx; border-radius: 12rpx; background: #f5f5f5; font-size: 26rpx; }
.panel-page .qr-upload-wrap { display: flex; align-items: center; justify-content: center; width: 280rpx; height: 280rpx; border-radius: 16rpx; }
.qr-placeholder-text { font-size: 26rpx; }
.header-card,.stats-card { background: linear-gradient(135deg,#667eea,#764ba2); border-radius: 24rpx; margin-bottom: 24rpx; overflow: hidden; color: #fff; }
.header-content { padding: 36rpx 32rpx; }
.money-item { display: flex; flex-direction: column; gap: 8rpx; }
.money-item-center { align-items: center; text-align: center; margin-bottom: 28rpx; }
.money-row { display: flex; justify-content: space-between; }
.money-row-bottom { border-top: 1rpx solid rgba(255,255,255,.2); padding-top: 24rpx; }
.money-label { color: rgba(255,255,255,.85); font-size: 24rpx; }
.money-value { color: #fff; font-size: 40rpx; font-weight: 700; }
.money-income,.money-withdraw { font-size: 28rpx; }
.stats-card { display: flex; padding: 40rpx 20rpx; }
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-value { font-size: 48rpx; font-weight: 700; }
.stat-label { font-size: 24rpx; margin-top: 8rpx; }
.list-header { font-size: 32rpx; font-weight: 600; margin-bottom: 18rpx; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 64rpx 20rpx 96rpx; font-size: 28rpx; color: #777; text-align: center; }
.empty-symbol { display: flex; justify-content: center; align-items: center; width: 100rpx; height: 100rpx; border: 2rpx solid #e6dbce; border-radius: 24rpx; font-size: 48rpx; color: #c8b49d; margin-bottom: 28rpx; }
