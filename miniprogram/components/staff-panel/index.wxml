<view class="panel-page mode-{{mode}}">
  <view class="navbar"><text class="navbar-title">{{title}}</text></view>
  <view class="integration-notice"><text>部分业务暂未接通</text><text>管事邀请码、我的下级已接通；其余未接通项目不显示虚构数据，不产生资金或资料提交。</text></view>

  <block wx:if="{{mode === 'center'}}">
    <view class="section auth-section">
      <view class="auth-header"><text class="section-title">接单授权</text><text class="auth-status-badge {{profile.granted ? 'auth-status-active' : 'auth-status-inactive'}}">{{profile.granted ? '已开通' : '未确认'}}</text></view>
      <view class="auth-content"><view class="auth-detail"><text class="auth-label">打手昵称</text><text class="auth-value">{{profile.name}}</text></view><view class="auth-detail"><text class="auth-label">用户ID</text><text class="auth-value">{{profile.numericId || '—'}}</text></view><text class="muted-note">打手授权仍由商户后台开通；管事邀请码在下面「管事功能」里兑换。</text></view>
    </view>
    <view class="section parent-section">
      <text class="section-title">上级管事</text>
      <block wx:if="{{steward.superior}}">
        <text class="muted-note">你的上级管事：{{steward.superior.displayName}}（ID {{steward.superior.numericId || '—'}}）</text>
        <text class="muted-note">你提现时，商户按 {{withdrawFeeText}} 收取提现手续费。</text>
        <button class="outline-button" disabled>联系上级 · 暂未接通</button>
      </block>
      <text wx:elif="{{steward.isSteward}}" class="muted-note">你是商户直接开通的管事，没有上级管事。</text>
      <text wx:else class="muted-note">还没有绑定上级管事。输入管事邀请码即可加入。</text>
    </view>
    <view class="section manager-section">
      <text class="section-title">管事功能</text>
      <block wx:if="{{steward.isSteward}}">
        <view class="steward-code-row"><text class="muted-note">我的邀请码（长期有效，可反复使用）</text><text class="steward-code">{{steward.myCode || '生成中…'}}</text></view>
        <view class="manager-actions"><button bindtap="generate">生成邀请码</button><button bindtap="copyCode">复制我的邀请码</button></view>
        <text class="muted-note">把邀请码发给打手，他输入后就成为你的下级打手。</text>
      </block>
      <block wx:else>
        <text class="muted-note">输入商户发给你的管事邀请码，即可升级为管事。</text>
        <button class="wide-button" bindtap="redeem">输入邀请码成为管事</button>
      </block>
      <button class="wide-button" data-target="subordinates" bindtap="navigate">查看下级打手 ›</button>
    </view>
    <view class="section my-bill"><view class="section-header"><text class="section-title">我的资金</text><button class="text-link" data-target="balanceLog" bindtap="navigate">余额明细 ›</button></view><view class="bill-list"><button wx:for="{{funds}}" wx:key="name" class="bill-item" data-target="{{item.target}}" bindtap="navigate"><text class="bill-num">—</text><text class="bill-label">{{item.name}}</text></button></view><text class="muted-note">佣金与保证金尚未接通，不等同于客户消费余额。</text></view>
    <view class="section level-info-section"><text class="section-title">陪玩等级信息</text><view class="level-info-row">我的服务评分：—</view><view class="level-info-row">陪玩类型：—</view><view class="level-info-row">我的陪玩等级：—</view><view class="level-info-row">等级到期时间：—</view><text class="muted-note">等级数据尚未接通。</text></view>
  </block>

  <block wx:elif="{{mode === 'withdraw'}}">
    <view class="card card-glass"><view class="card-title">提现金额</view><view class="amount-row"><text class="balance-hint">可用佣金 — 元</text><button class="text-link" disabled>全部提现</button></view><view class="amount-input-wrap"><text class="amount-symbol">￥</text><input class="amount-input" disabled placeholder="暂未接通" type="digit" /></view><view class="min-amount-tip">最低提现金额：暂未配置</view><view class="commission-detail"><view class="commission-row"><text>提现手续费 ({{withdrawFeeText}})</text><text>— 元</text></view><view class="commission-row actual-row"><text>实际到账</text><text class="actual-value">— 元</text></view></view><view class="card-actions"><button class="btn-secondary" data-target="settlement" bindtap="navigate">设置提现信息</button><button class="btn-secondary" data-target="withdrawLog" bindtap="navigate">提现记录</button></view></view>
    <view class="card card-glass"><view class="card-title">提现方式</view><view wx:for="{{methods}}" wx:key="*this" class="option-row disabled"><text class="option-label">{{item}}</text><text class="option-closed">未开放</text><view class="option-radio" /></view></view>
    <button class="btn-submit" disabled>发起提现 · 暂未接通</button>
    <view class="card card-glass withdraw-notice-card"><view class="withdraw-notice-title"><view class="withdraw-notice-accent" /><text>提现说明</text></view><text class="withdraw-notice-text">佣金账本、提现规则和打款接口尚未接通。当前不会发起提现，也不会从客户消费余额扣款。</text></view>
  </block>

  <block wx:elif="{{mode === 'bound'}}">
    <view class="card card-glass balance-card"><view class="balance-row"><text class="balance-label">当前保证金</text><text class="balance-num">—</text><text class="balance-unit">元</text></view></view>
    <view class="card card-glass amount-card"><view class="card-title">选择充值金额</view><text class="muted-note">充值档位尚未配置</text><view class="amount-grid"><button class="amount-item" disabled><text class="amount-value">自定义</text><text class="amount-desc">暂未开放</text></button></view></view><button class="btn-submit" disabled>确定充值 · 暂未接通</button>
  </block>

  <block wx:elif="{{mode === 'fine'}}">
    <view class="tabs-wrap"><button wx:for="{{fineTabs}}" wx:key="*this" class="tab-item {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="select">{{item}}</button></view>
    <view class="empty-state"><view class="empty-symbol">—</view><text>罚单数据尚未接通</text><text class="muted-note">无法查询罚单或待缴金额</text></view><button class="btn-submit" disabled>交罚款 (待缴：—)</button>
  </block>

  <block wx:elif="{{mode === 'settlement'}}">
    <view class="tabs-row"><button wx:for="{{methods}}" wx:key="*this" class="method-tab {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="select">{{item}}</button></view>
    <view class="card card-glass"><text class="card-title">{{methods[selected]}}提现资料</text>
      <view class="form-row"><text class="form-label">{{selected === 2 ? '持卡人姓名' : '收款人姓名'}}</text><input class="form-input" disabled placeholder="接口未接通，暂不收集资料" /></view>
      <view class="form-row"><text class="form-label">{{methods[selected]}}账号</text><input class="form-input" disabled placeholder="暂不可填写" /></view>
      <view wx:if="{{selected === 2}}" class="form-row"><text class="form-label">开户行名称</text><input class="form-input" disabled placeholder="暂不可填写" /></view>
      <view wx:else class="form-section"><text class="form-label">{{methods[selected]}}收款码</text><button class="qr-upload-wrap" disabled><text class="qr-placeholder-text">上传暂未接通</text></button></view>
    </view><button class="btn-submit" disabled>保存信息 · 暂未接通</button>
  </block>

  <block wx:elif="{{mode === 'balanceLog'}}">
    <view class="header-card"><view class="header-content"><view class="money-item money-item-center"><text class="money-label">可用佣金</text><text class="money-value">¥ —</text></view><view class="money-row money-row-bottom"><view class="money-item"><text class="money-label">累计收入</text><text class="money-value money-income">¥ —</text></view><view class="money-item"><text class="money-label">累计提现</text><text class="money-value money-withdraw">¥ —</text></view></view></view></view>
    <view class="tabs-wrap"><button wx:for="{{balanceTabs}}" wx:key="*this" class="tab-item {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="select">{{item}}</button></view><view class="empty-state"><view class="empty-symbol">—</view><text>佣金流水尚未接通</text></view>
  </block>

  <block wx:elif="{{mode === 'subordinates'}}"><view class="stats-card"><view class="stat-item"><text class="stat-value">{{steward.subordinates.length}}</text><text class="stat-label">下级总数</text></view><view class="stat-item"><text class="stat-value">{{steward.isSteward ? '已开通' : '—'}}</text><text class="stat-label">管事身份</text></view><view class="stat-item"><text class="stat-value">{{steward.superior ? '已绑定' : '—'}}</text><text class="stat-label">上级管事</text></view></view><view class="list-header">下级列表</view><view wx:if="{{steward.subordinates.length}}" class="subordinate-list"><view wx:for="{{steward.subordinates}}" wx:key="numericId" class="subordinate-row"><view class="subordinate-main"><text class="subordinate-name">{{item.displayName}}</text><text class="subordinate-id">ID {{item.numericId || '—'}}</text></view><text class="subordinate-code">邀请码 {{item.code}}</text></view></view><view wx:else class="empty-state"><view class="empty-symbol">—</view><text>{{steward.isSteward ? '还没有下级打手' : '你还不是管事，暂时没有下级'}}</text><text class="muted-note">把「我的邀请码」发给打手，他输入后就会出现在这里。</text></view></block>
  <view wx:else class="empty-state"><view class="empty-symbol">—</view><text>{{title}}尚未接通</text><text class="muted-note">功能入口已保留，接通业务后启用。</text><button class="outline-button" bindtap="explain">查看说明</button></view>
</view>
