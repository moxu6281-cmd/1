# 本地与宝塔反向代理默认仅监听回环地址；不要暴露开发模式
HOST=127.0.0.1
PORT=5180
NODE_ENV=development

# 生产部署必填客户自己的 HTTPS 域名；未完成交易验收时只开放管理准备功能
PUBLIC_ORIGIN=

# 每个客户独立生成至少 16 位密码，不要把真实密钥写入交付包
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=

# 登录状态默认保留 24 小时
SESSION_TTL_MS=86400000

# 单次请求大小，支持后台上传压缩后的商品图
MAX_BODY_BYTES=25165824

# MySQL 8.0+，数据库和连接统一使用 utf8mb4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=club_app
DB_PASSWORD=
DB_NAME=esports_club
DB_CONNECTION_LIMIT=10

# 仅 Docker Compose 创建 MySQL 容器时使用
MYSQL_ROOT_PASSWORD=

# 仅本机演示可显式开启；生产环境禁止演示充值和历史示例数据导入
ENABLE_DEMO_RECHARGE=false
SEED_DEMO_DATA=false

# 微信小程序登录（生产必填）：小程序 AppID 与 AppSecret，只保存在服务器，严禁写进小程序源码
WX_APPID=
WX_SECRET=

# 客户交易接口（下单/钱包/聊天）生产开关：微信支付接入并完成验收前保持关闭
ALLOW_PUBLIC_TRADE=false

# 客户会话令牌有效期（默认 7 天）
CUSTOMER_SESSION_TTL_MS=604800000

# 微信支付商户号配置（接入真实付款时填写，全部只保存在服务器）
# WXPAY_MCHID=
# WXPAY_SERIAL_NO=
# WXPAY_PRIVATE_KEY_PATH=
# WXPAY_APIV3_KEY=
# WXPAY_NOTIFY_URL=
