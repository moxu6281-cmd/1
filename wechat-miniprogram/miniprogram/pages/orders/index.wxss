.orders-page { background: linear-gradient(180deg, #edf6ff 0%, #f8fafc 46%, #fffaf0 100%); }
/* 订单状态条：用户要求「横着的一行、占满整行，所以不需要左右滑」。
   7 个状态：全部/待付款/待接单/待开始/服务中/待结单/已完成。
   做法：外层 scroll-view scroll-x（保住"能左右滑"的能力）+ 内层 .status-tabs-inner 做 flex 容器，
   7 个按钮 flex: 1 1 0 等宽平分 width:100%，正好占满整行 —— 没有溢出，所以滑不动、也不需要滑。
   踩过的坑：2026-09-15 第一版把 display:flex 直接写在 .status-tabs（也就是 scroll-view）上，
   真机上不生效、按钮挤在左边 —— scroll-view 内部还有一层内容容器，flex 挂在自己身上会断链。
   display: inline-block 保留作兜底：万一 flex 容器没生效，也还是一行（按文字宽度排），不会变成一列。 */
.status-tabs { margin-bottom: 22rpx; padding: 6rpx; border: 1rpx solid #e4ebf1; border-radius: 18rpx; background: rgba(255,255,255,.9); box-shadow: 0 12rpx 28rpx rgba(32,52,72,.05); }
.status-tabs-inner { display: flex; flex-wrap: nowrap; align-items: center; width: 100%; }
.status-tabs-inner button { display: inline-block; flex: 1 1 0; min-width: 0; width: auto; white-space: nowrap; margin: 0 5rpx 0 0; padding: 10rpx 4rpx; border-radius: 26rpx; background: transparent; color: #647184; font-size: 22rpx; line-height: 1.45; text-align: center; }
.status-tabs-inner button:last-child { margin-right: 0; }
.status-tabs-inner button.active { background: linear-gradient(135deg, #ffad20, #ff8a00); color: #fff; font-weight: 700; box-shadow: 0 8rpx 18rpx rgba(255,145,0,.2); }
.order { margin-bottom: 18rpx; padding: 26rpx; border-radius: 18rpx; }
.order-head, .order-info, .order-bottom { display: flex; justify-content: space-between; gap: 20rpx; }
.order-head { color: #7a8798; font-size: 22rpx; }.order-head text:last-child { font-weight: 700; }.order-product { display: block; margin: 22rpx 0; color: #172033; font-size: 31rpx; font-weight: 700; }.order-info { color: #667386; line-height: 1.5; }.order-bottom { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #edf0f3; color: #9199a5; }
.chat-btn { margin-top: 18rpx; border-radius: 999rpx; background: #ff9800; color: #fff; font-size: 24rpx; font-weight: 700; }
/* 2026-09-20 修「聊天窗口和底部导航栏重叠」：根因是 z-index 给低了。
   自定义底部导航 .tab-shell 是 z-index:90，这里原来是 60 → 导航条画在弹层之上，
   正好压住 .chat-form 的输入框和「发送」。改成 115（与同页 .service-mask 同档），
   底部再让开 iPhone 的 home 指示条。
   规矩：本页任何 fixed 弹层 z-index 必须 > 90，否则会被底部导航盖住。 */
.chat-mask { position: fixed; inset: 0; z-index: 115; display: flex; align-items: flex-end; padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); background: rgba(15, 23, 42, .45); box-sizing: border-box; }
.chat-sheet { width: 100%; max-height: 78vh; display: flex; flex-direction: column; overflow: hidden; border-radius: 28rpx; background: #fff; box-shadow: 0 36rpx 88rpx rgba(15, 23, 42, .24); }
.chat-head, .chat-form { display: flex; align-items: center; gap: 18rpx; padding: 22rpx; border-bottom: 1rpx solid #e5edf5; }
.chat-head { justify-content: space-between; }.chat-head text { display: block; }.chat-head text:first-child { color: #172033; font-size: 30rpx; font-weight: 800; }.chat-head text:last-child { margin-top: 4rpx; color: #64748b; font-size: 22rpx; }
.chat-head button { width: 58rpx; height: 58rpx; min-height: 58rpx; padding: 0; border-radius: 50%; background: #f1f5f9; color: #172033; line-height: 58rpx; }
.chat-messages { height: 50vh; padding: 22rpx; background: #f8fafc; box-sizing: border-box; }
.chat-message { max-width: 82%; margin-bottom: 18rpx; }.chat-message.mine { margin-left: auto; text-align: right; }.chat-message .sender, .chat-message .read-state { display: block; color: #64748b; font-size: 20rpx; }
.chat-message view { margin: 8rpx 0; padding: 18rpx 22rpx; border-radius: 22rpx; background: #fff; color: #172033; line-height: 1.5; text-align: left; word-break: break-word; }.chat-message.mine view { background: #dcfce7; }
.chat-empty { padding: 50rpx 0; color: #64748b; text-align: center; }
.chat-form { border-top: 1rpx solid #e5edf5; border-bottom: 0; }.chat-form input { flex: 1; height: 70rpx; min-width: 0; padding: 0 24rpx; border-radius: 999rpx; background: #f8fafc; box-sizing: border-box; }.chat-form button { width: 128rpx; min-height: 70rpx; border-radius: 999rpx; background: #ff9800; color: #fff; font-weight: 700; line-height: 70rpx; }

/* 订单评价入口：只有「已下单且订单已成立」的订单才出现；评价是否公开由后台决定，页面不给客户任何提示。 */
.orders-page .review-entry { width: 117rpx; min-width: 117rpx; max-width: 117rpx; height: 52rpx; min-height: 52rpx; max-height: 52rpx; margin: 12rpx 0 0 auto; padding: 0; border-radius: 14rpx; background: #f0f0f0; color: #333; font-size: 20rpx; font-weight: 400; line-height: 52rpx; }
/* 订单评价区（用户 2026-09-17 定的配色）：
   「已评价」文字红色、点亮的星橙色、没点亮的星白色。
   未点亮的星是白的、卡片也是白的 → 等于看不见，只为占住 5 颗的位置；
   「已评价」原来跟订单状态标签一样是青绿 #0b8f7b（同一批改成红）。 */
.review-flag { margin-top: 18rpx; text-align: center; color: #94a3b8; font-size: 23rpx; }
.review-flag.is-ok { color: #e5534b; font-weight: 700; }
.review-stars-on { color: #ff9800; }
.review-stars-off { color: #fff; }
/* 同上：原来是 90，和底部导航打平（导航在 DOM 里更靠后 → 反而压住弹层），提到 110。 */
.review-mask { position: fixed; inset: 0; z-index: 110; display: flex; align-items: center; padding: 32rpx; background: rgba(15,23,42,.62); box-sizing: border-box; }
.review-dialog { width: 100%; padding: 36rpx; border-radius: 24rpx; background: #fff; box-sizing: border-box; }
.review-dialog-title { display: block; color: #172033; font-size: 32rpx; font-weight: 800; }
.review-dialog-sub { display: block; margin-top: 10rpx; color: #64748b; font-size: 24rpx; }
.review-rating { display: flex; gap: 12rpx; margin: 26rpx 0 18rpx; }
.review-rating text { color: #d8dee7; font-size: 52rpx; line-height: 1; }
.review-rating text.on { color: #f1b900; }
.review-textarea { width: 100%; height: 190rpx; padding: 20rpx; border-radius: 16rpx; background: #f8fafc; color: #172033; font-size: 26rpx; line-height: 1.6; box-sizing: border-box; }
.review-dialog-actions { display: flex; gap: 18rpx; margin-top: 26rpx; }
.review-dialog-actions button { flex: 1; border-radius: 999rpx; font-size: 28rpx; font-weight: 700; }
.review-dialog-actions .ghost { background: #fff7ea; color: #a6600a; }
.review-dialog-actions .primary { background: #ff9800; color: #fff; }
.orders-page { background: #f7f3e9; }
.orders-page .status-tabs { border: 0; background: transparent; box-shadow: none; }
.orders-page .status-tabs button { background: #fff; color: #777; }
.orders-page .status-tabs button.active { background: #ff9800; color: #fff; box-shadow: none; }
.orders-page .status-tabs { margin-bottom: 28rpx; padding: 4rpx 0; }
.orders-page .status-tabs button { min-height: 62rpx; margin-right: 8rpx; padding: 10rpx 4rpx; border-radius: 31rpx; font-size: 23rpx; line-height: 42rpx; }
.orders-page .order { margin-bottom: 24rpx; padding: 34rpx; border: 0; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(92, 76, 45, .06); }
.orders-page .order-head { align-items: center; min-height: 48rpx; padding-bottom: 24rpx; border-bottom: 1rpx solid #e7e9eb; }
.order-time { color: #666; font-size: 25rpx; line-height: 1.5; }
/* 订单状态标签：6 种状态统一红色（用户 2026-09-17 原话「都为红色就行」）。
   原先按 tone 分了 5 套配色（danger #e5534b / warning #e6a82e / success #5dbb48 /
   muted #8a8f98 / plain #333），但都被上面 .order-head text:last-child 的 color 压掉，
   实际一直显示青绿 #0b8f7b —— tone 配色等于白写。所以直接定死一套红，不再分色。 */
.order-status { flex-shrink: 0; padding: 6rpx 14rpx; border-radius: 8rpx; background: #fff2f0; color: #e5534b; font-size: 24rpx; line-height: 1.45; }
/* 2026-09-20 用户要求删掉订单页的搜索框（状态条下面那条「搜索订单」），
   .order-search / .order-search input / .order-search button 三条规则一并删除。
   注意：删的是**客户「我的订单」**这一页；打手工作台的搜索还在（那是用户 2026-09-20 单独要求接的服务端模糊搜索）。
   别再往回加。 */
.order-product-row { display: flex; align-items: center; gap: 26rpx; min-height: 188rpx; margin: 30rpx 0; }
.order-product-image { width: 188rpx; min-width: 188rpx; max-width: 188rpx; height: 188rpx; min-height: 188rpx; max-height: 188rpx; flex: 0 0 188rpx; border-radius: 12rpx; background: #f6f6f6; }
.order-product-main { display: flex; flex: 1; min-width: 0; min-height: 188rpx; flex-direction: column; justify-content: center; }
.orders-page .order-product { display: -webkit-box; overflow: hidden; margin: 0; color: #171717; font-size: 31rpx; font-weight: 700; line-height: 1.38; overflow-wrap: anywhere; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.order-price-row { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; color: #999; font-size: 24rpx; }
.order-quantity { flex-shrink: 0; margin-left: 16rpx; }
.orders-page .price { color: #e5534b; font-weight: 700; font-size: 32rpx; }
.order-description { display: flex; align-items: flex-end; gap: 8rpx; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #eeeeec; color: #929292; font-size: 24rpx; line-height: 1.65; }
.order-description text:first-child { display: -webkit-box; flex: 1; min-width: 0; overflow: hidden; overflow-wrap: anywhere; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.order-description-link { flex: 0 0 auto; color: #bd7212; }
.order-fields { padding: 14rpx 0 10rpx; border-top: 1rpx solid #e7e9eb; }
.order-field { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; min-height: 52rpx; padding: 7rpx 0; font-size: 26rpx; line-height: 1.5; }
.order-field-label { flex: 0 0 150rpx; color: #999; }
.order-field-value { min-width: 0; color: #333; text-align: right; overflow-wrap: anywhere; }
.order-number-wrap { display: flex; flex: 1; align-items: center; justify-content: flex-end; min-width: 0; gap: 14rpx; }
.order-number { display: block; min-width: 0; overflow: hidden; color: #333; white-space: nowrap; text-overflow: ellipsis; }
/* 「复制」按钮：和订单详情页同一个坑（内置 button 自带定宽），同一套 min/max 四道封印 + 同一个尺寸，
   两个页面的复制钮看着才是一套东西。 */
.order-fields button { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 116rpx; min-width: 116rpx; max-width: 116rpx; height: 48rpx; min-height: 48rpx; max-height: 48rpx; margin: 0; padding: 0; background: #fff; border: 1rpx solid #e8b64c; color: #c6982a; font-size: 24rpx; line-height: 1; border-radius: 12rpx; box-sizing: border-box; }
.order-paid { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; padding: 12rpx 0; border-top: 1rpx solid #e7e9eb; border-bottom: 1rpx solid #e7e9eb; color: #222; font-size: 28rpx; }
.order-paid-values { display: flex; align-items: baseline; gap: 14rpx; }
.order-original { color: #aaa; font-size: 23rpx; text-decoration: line-through; }
/* 五个等宽按钮铺满一行，保留参考图缩小后的高度。 */
.order-actions { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12rpx; padding-top: 16rpx; }
.order-actions button { width: 100%; min-width: 0; max-width: 100%; height: 52rpx; min-height: 52rpx; max-height: 52rpx; margin: 0; padding: 0; border: 0; border-radius: 14rpx; background: #f0f0f0; color: #333; font-size: 20rpx; line-height: 52rpx; white-space: nowrap; }
.order-actions button.primary { background: #fdbc28; color: #fff; font-weight: 400; }
.order-actions .review-entry { width: 100%; max-width: 100%; margin: 0; }
/* 模板先渲染主操作以保证优先级；视觉顺序按截图把橙色按钮排到最右。 */
.order-actions button.wide { order: 1; }
.order-actions button[disabled] { border-color: #f7d9ab; background: #ffdca8; color: rgba(255,255,255,.9); }
.order-end { padding: 44rpx 0 26rpx; color: #aaa39a; font-size: 26rpx; text-align: center; }
.orders-page { height: 100vh; min-height: 0; display: flex; flex-direction: column; overflow: hidden; padding-bottom: calc(148rpx + env(safe-area-inset-bottom)); }
.orders-page .status-tabs { flex: 0 0 auto; }
.order-scroll { flex: 1 1 0; width: 100%; height: 0; min-height: 0; }
/* 2026-09-20 按要求删掉了状态标签右上角的红点（.status-dot），别再往回加。 */
.service-mask { position: fixed; inset: 0; z-index: 115; display: flex; align-items: flex-end; background: rgba(15,23,42,.48); }
.service-sheet { width: 100%; padding: 30rpx 34rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 26rpx 26rpx 0 0; background: #fff; box-shadow: 0 -12rpx 40rpx rgba(15,23,42,.12); }
.service-head { display: flex; align-items: center; justify-content: space-between; color: #172033; font-size: 31rpx; font-weight: 700; }
.service-head button { width: 56rpx; min-width: 56rpx; height: 56rpx; min-height: 56rpx; border-radius: 50%; background: #fff2df; color: #a6600a; font-size: 36rpx; line-height: 56rpx; }
.service-product { display: block; margin-top: 24rpx; color: #172033; font-size: 28rpx; font-weight: 700; }
.service-content { display: block; max-height: 46vh; overflow-y: auto; margin-top: 14rpx; color: #586274; font-size: 26rpx; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
.service-close { width: 100%; min-height: 72rpx; margin-top: 30rpx; border-radius: 12rpx; background: #ff9800; color: #fff; font-size: 27rpx; font-weight: 700; line-height: 72rpx; }
.complaint-mask { position: fixed; inset: 0; z-index: 120; display: flex; align-items: flex-end; background: rgba(15,23,42,.48); }
.complaint-sheet { width: 100%; max-height: 85vh; overflow-y: auto; padding: 30rpx 34rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 26rpx 26rpx 0 0; background: #fff; }
.complaint-head { display: flex; align-items: center; justify-content: space-between; color: #172033; font-size: 31rpx; font-weight: 700; }
.complaint-head button { width: 56rpx; min-width: 56rpx; height: 56rpx; min-height: 56rpx; border-radius: 50%; background: #fff2df; color: #a6600a; font-size: 36rpx; line-height: 56rpx; }
.complaint-order-no { display: block; margin-top: 18rpx; color: #868e96; font-size: 23rpx; overflow-wrap: anywhere; }
.complaint-state { display: block; margin-top: 24rpx; color: #a6600a; font-size: 25rpx; }
.complaint-content { display: block; margin-top: 12rpx; color: #333; font-size: 27rpx; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; }
.complaint-input { width: 100%; height: 220rpx; margin-top: 26rpx; padding: 18rpx; border-radius: 14rpx; background: #f7f8fa; color: #333; font-size: 26rpx; line-height: 1.6; }
.complaint-submit { width: 100%; min-height: 72rpx; margin-top: 24rpx; border-radius: 14rpx; background: #ff9800; color: #fff; font-size: 27rpx; font-weight: 700; line-height: 72rpx; }
