/* 工作台独立样式，避免影响老板端及全局页面。尺寸以 750rpx 设计稿为准。 */
.main-container { min-height: 100vh; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg,#d0eefc,#b4a0f0 50%,#ffeef8); color: #333; line-height: 1.6; }
.main-container.hall-page { background: #fff; }
.main-container.flow-page { box-sizing: border-box; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg,#e5f2dc 0,#c7b8ef 44%,#faedff 100%); }
.main-container.detail-page { background: #f7f9ff; }
.workspace-content { background: #f7f2e8; }
.main-container button { width: auto; min-width: 0; max-width: 100%; margin: 0; padding: 0; border: 0; border-radius: 16rpx; color: #aa4c08; background: #fff1df; font-size: 24rpx; line-height: 1.5; }
.main-container button::after { border: none; }
.main-container button[disabled] { color: #ab784c; background: #f7e4d1; opacity: .8; }
.main-container .button-hover { opacity: .76; }
.top-section { width: 100%; padding-top: 20rpx; }
.top-content { padding: 20rpx 24rpx 0; }
.profile-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.profile-left { display: flex; align-items: center; flex: 1; gap: 16rpx; min-width: 0; }
.avatar-wrap { width: 100rpx; height: 100rpx; flex-shrink: 0; background: #e8e4df; border: 4rpx solid #fff; border-radius: 50%; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.15); overflow: hidden; }
.avatar { width: 100%; height: 100%; border-radius: 50%; }
.avatar-placeholder { display: flex; align-items: center; justify-content: center; background: #fff4e3; color: #cf6a16; font-size: 40rpx; }
.name-col { display: flex; flex: 1; flex-direction: column; align-items: flex-start; min-width: 0; gap: 8rpx; }
.username-wrap { max-width: 100%; min-width: 0; }
.username { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 32rpx; font-weight: 600; color: #090b08; }
.uid { font-size: 20rpx; color: #666; overflow-wrap: anywhere; }
.main-container .phone-verify-btn { min-height: 40rpx; padding: 4rpx 14rpx; font-size: 19rpx; border-radius: 20rpx; }
.profile-right { flex-shrink: 0; }
.main-container .work-status-btn { padding: 10rpx 16rpx; border-radius: 36rpx; border: 1rpx solid #edb57a; background: #fff1df; }
.work-status-text { font-size: 20rpx; font-weight: 600; }
.uid-line { height: 1rpx; margin: 24rpx auto; width: 100%; background: rgba(0,0,0,.08); }
.section { background: #fff; border-radius: 24rpx; box-shadow: 0 2rpx 20rpx rgba(0,0,0,.04); margin: 0 24rpx 24rpx; padding: 32rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; gap: 12rpx; }
.main-container .section-title { display: block; margin: 0; color: #090b08; font-size: 28rpx; font-weight: 600; line-height: 1.6; }
.main-container .text-action { background: transparent; font-size: 22rpx; padding: 8rpx; }
.order-list { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 6rpx; }
.main-container .order-stat-item { display: flex; flex-direction: column; align-items: center; width: 100%; min-width: 0; max-width: 100%; padding: 12rpx 0; background: transparent; }
.stat-num { color: #090b08; font-size: 40rpx; font-weight: 700; }
.stat-txt { color: #ad540d; font-size: 22rpx; white-space: nowrap; }
.order-line { border-bottom: 1rpx solid rgba(0,0,0,.08); margin-top: 20rpx; width: 100%; }
.main-container .game-item { display: flex; align-items: center; justify-content: space-between; width: 100%; background: transparent; border-radius: 0; border-bottom: 1rpx solid rgba(0,0,0,.08); padding: 28rpx 0; gap: 20rpx; text-align: left; }
.game-item:last-child { border-bottom: none; padding-bottom: 0; }
.game-left { display: flex; align-items: center; min-width: 0; gap: 20rpx; }
.game-left > text { font-size: 24rpx; color: #333; overflow-wrap: anywhere; }
.game-icon-box { width: 64rpx; height: 64rpx; flex-shrink: 0; border-radius: 20rpx; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #fff1df; color: #c7650d; font-size: 30rpx; }
.game-icon-box image { width: 100%; height: 100%; }
.game-right { display: flex; align-items: center; flex-shrink: 0; gap: 10rpx; }
.game-pending { font-size: 22rpx; color: #d86a12; font-weight: 600; }
.arrow { color: #bc8b69; font-size: 36rpx; line-height: 1; }
.more-section { padding: 32rpx 20rpx; }
.main-container .more-title { font-size: 24rpx; margin-bottom: 24rpx; padding-left: 12rpx; }
.more-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 8rpx; }
.main-container .more-item { display: flex; align-items: center; flex-direction: column; width: 100%; min-width: 0; max-width: 100%; gap: 12rpx; padding: 20rpx 0; background: transparent; }
.more-icon-wrap { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; color: #d86a12; }
.more-label { font-size: 24rpx; text-align: center; }
.main-container .staff-identity { width: calc(100% - 48rpx); margin: 0 24rpx 24rpx; padding: 22rpx 24rpx; display: flex; align-items: center; justify-content: space-between; background: #fff4e6; border: 1rpx solid #efc997; }
.workspace-header { display: flex; justify-content: space-between; align-items: center; min-height: 100rpx; gap: 16rpx; padding: 24rpx; font-size: 34rpx; font-weight: 600; }
.hall-categories { width: 100%; white-space: nowrap; margin: 8rpx 0 28rpx; }
.hall-category-list { display: inline-flex; gap: 16rpx; padding: 0 24rpx 18rpx; }
.main-container .hall-category { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; width: 174rpx; height: 142rpx; flex-shrink: 0; position: relative; margin-top: 28rpx; padding: 0 8rpx 12rpx; border-radius: 30rpx; background: #eee; color: #777; font-size: 22rpx; font-weight: 600; }
.main-container .hall-category.selected { background: #ff686d; color: #fff; }
.hall-category-icon { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; margin-bottom: 8rpx; border-radius: 22rpx; background: #333; color: #fff; font-size: 30rpx; object-fit: cover; }
.hall-orders { padding: 0 24rpx; }
.bond-notice { display: flex; align-items: center; gap: 12rpx; margin: 0 24rpx 24rpx; padding: 18rpx 22rpx; border-radius: 16rpx; background: #fff6e9; color: #9a5508; font-size: 24rpx; }
.main-container .bond-notice button { margin-left: auto; padding: 8rpx 18rpx; border-radius: 12rpx; background: #fb8b23; color: #fff; font-size: 23rpx; white-space: nowrap; }
.hall-order { margin-bottom: 24rpx; padding: 28rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(72,59,96,.08); }
.hall-boss,.hall-boss-copy > view,.hall-meta,.hall-product,.hall-bottom,.flow-card-head,.boss-row,.flow-product,.flow-field,.flow-footer { display: flex; align-items: center; }
.hall-boss { gap: 14rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #eeeafb; }
.hall-avatar,.boss-avatar { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; flex-shrink: 0; border: 3rpx solid #a879ed; border-radius: 50%; background: #ededf2; color: #fff; font-size: 36rpx; }
.hall-boss-copy { flex: 1; min-width: 0; }
.hall-boss-copy > view { gap: 10rpx; }
.hall-boss-name,.boss-name { color: #282830; font-size: 29rpx; font-weight: 700; }
.hall-boss-role,.muted { color: #999; font-size: 23rpx; }
.hall-benefit { color: #8d54d8; font-size: 22rpx; }
.member-badge { flex-shrink: 0; padding: 4rpx 12rpx; border: 1rpx solid #ecc77f; border-radius: 28rpx; background: #fff5d8; color: #9b6e28; font-size: 22rpx; }
.hall-meta { justify-content: space-between; gap: 12rpx; margin: 24rpx 0; color: #8559da; font-size: 23rpx; }
.hall-meta text:last-child { color: #e66585; }
.hall-product { align-items: flex-start; gap: 20rpx; min-height: 150rpx; }
.hall-product image,.hall-product-empty { width: 150rpx; height: 150rpx; flex-shrink: 0; border-radius: 8rpx; }
.hall-product-empty,.flow-image-empty { display: flex; align-items: center; justify-content: center; background: #f4ecfa; color: #a27dc4; }
.hall-product > text { flex: 1; color: #222; font-size: 29rpx; font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
.hall-bottom { justify-content: space-between; margin-top: 20rpx; }
.hall-price { color: #e54f67; font-size: 34rpx; font-weight: 700; }
.hall-quantity { color: #999; font-size: 23rpx; }
.main-container .hall-bottom button { min-width: 132rpx; padding: 10rpx 24rpx; border-radius: 60rpx; background: #fb8b23; color: #fff; font-size: 26rpx; }
.flow-header { display: flex; align-items: center; min-height: 68rpx; padding: 8rpx 24rpx; }
.main-container .flow-header button { padding: 0 12rpx; background: rgba(255,255,255,.8); color: #555; font-size: 25rpx; }
.flow-card,.preview-status { margin: 0 24rpx 24rpx; padding: 28rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 6rpx 22rpx rgba(68,54,105,.06); }
.flow-page .flow-card,.flow-page .preview-status,.detail-progress { animation: flow-content 280ms ease-out both; }
@keyframes flow-content { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: translateY(0); } }
.preview-status { padding: 30rpx; }
.preview-status > view { display: flex; align-items: center; gap: 16rpx; }
.preview-status > text { display: block; margin-top: 6rpx; color: #777; font-size: 24rpx; }
.preview-tag { padding: 2rpx 16rpx; border-radius: 50rpx; background: #f6efff; color: #8c57d2; font-size: 22rpx; }
.flow-title { display: block; color: #202126; font-size: 31rpx; font-weight: 700; }
.flow-card-head { justify-content: space-between; }
.boss-row { gap: 20rpx; margin: 22rpx 0; }
.boss-avatar { width: 90rpx; height: 90rpx; }
.boss-info { display: flex; flex-direction: column; min-width: 0; }
.member-line { color: #8959ca; font-size: 23rpx; }
.benefit-line { color: #d89532; font-size: 23rpx; }
.preview-benefit { padding: 14rpx 18rpx; border-radius: 18rpx; background: #f8f3ff; color: #7952c5; font-size: 24rpx; }
.preview-benefit text + text { margin-left: 20rpx; }
.flow-product { gap: 20rpx; margin: 22rpx 0 28rpx; }
.flow-product image,.flow-image-empty { width: 144rpx; height: 144rpx; flex-shrink: 0; border-radius: 10rpx; }
.flow-product-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 22rpx; }
.flow-product-name { color: #222; font-size: 28rpx; font-weight: 700; overflow-wrap: anywhere; }
.flow-price,.flow-total text:last-child,.flow-footer > view text { color: #dc505b; font-size: 32rpx; font-weight: 700; }
.flow-subtitle { margin-top: 20rpx; }
.flow-field { justify-content: space-between; gap: 14rpx; min-height: 64rpx; border-bottom: 1rpx solid #eee; font-size: 25rpx; }
.flow-field > text:first-child { flex-shrink: 0; color: #8c8c95; }
.flow-field > text:last-child { text-align: right; overflow-wrap: anywhere; }
.flow-field .flow-value { flex: 1; min-width: 0; text-align: right; overflow-wrap: anywhere; }
.flow-total { padding-top: 20rpx; border: 0; }
.flow-footer { position: fixed; bottom: 0; left: 0; right: 0; z-index: 50; gap: 12rpx; min-height: 100rpx; padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); background: #fff; }
.flow-footer > view { flex: 1; font-size: 25rpx; white-space: nowrap; }
.main-container .flow-footer button { flex-shrink: 0; padding: 18rpx 24rpx; border-radius: 20rpx; font-size: 26rpx; }
.main-container .flow-footer .flow-primary { background: #ffa914; color: #fff; }
.main-container .flow-footer .flow-secondary,.main-container .chat-entry { background: #f4f4f6; color: #38383f; }
.main-container .chat-entry { width: 100%; padding: 16rpx; }
.flow-transition { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 80; display: flex; align-items: center; justify-content: center; pointer-events: none; animation: flow-step 900ms ease-out both; }
.flow-transition-card { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 28rpx 44rpx; border-radius: 24rpx; background: rgba(42,35,30,.9); color: #fff; box-shadow: 0 12rpx 36rpx rgba(0,0,0,.18); }
.flow-transition-card text:first-child { font-size: 31rpx; font-weight: 700; }
.flow-transition-card text:last-child { font-size: 24rpx; color: #ffcf94; }
@keyframes flow-step { 0% { opacity: 0; transform: translateY(28rpx) scale(.96); } 18%, 72% { opacity: 1; transform: translateY(0) scale(1); } 100% { opacity: 0; transform: translateY(-12rpx) scale(1); } }
.detail-progress { display: flex; justify-content: space-between; margin: 0 24rpx 24rpx; padding: 18rpx 28rpx; border-radius: 18rpx; background: #fff; color: #777; font-size: 24rpx; }
.detail-progress text { color: #e49420; }
.header-count { color: #999; font-size: 24rpx; font-weight: 400; }
.main-container .back-button { padding: 12rpx 18rpx; }
.header-spacer { width: 90rpx; }
.filter-scroll { white-space: nowrap; width: 100%; }
.filter-inner { display: flex; align-items: center; width: 100%; padding: 8rpx 24rpx 20rpx; gap: 12rpx; }
.main-container .filter-tab { padding: 12rpx 24rpx; border-radius: 100rpx; flex-shrink: 0; background: #fff8ed; color: #a75a1a; font-size: 26rpx; }
.main-container .filter-tab.selected { color: #fff; background: #ff8800; }
.search-box { display: flex; align-items: center; gap: 16rpx; margin: 24rpx; padding: 0 28rpx; min-height: 80rpx; border-radius: 100rpx; background: #fff; border: 2rpx solid #fff; }
.search-box input { flex: 1; width: 0; height: 80rpx; min-width: 0; font-size: 28rpx; }
.search-box > text { color: #666; }
/* 「搜索」是点得动的按钮（bindtap="submitSearch"）。纯文字的热区只有字本身那么大，
   手指一偏就点空 —— 表现就是「点了没反应」。给足 padding 和底色，让它真的是个按钮。
   特异性用 .search-box .search-action 压过上面的 `.search-box > text`。 */
.search-box .search-action { flex-shrink: 0; padding: 10rpx 24rpx; border-radius: 100rpx; background: #f2f2f2; font-size: 26rpx; }
.staff-order { margin: 0 24rpx 24rpx; padding: 32rpx; border: 2rpx solid #fff; border-radius: 24rpx; background: rgba(255,255,255,.9); box-shadow: 0 2rpx 20rpx rgba(0,0,0,.025); }
.card-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding-bottom: 24rpx; border-bottom: 1rpx solid #e9e5e0; color: #777; font-size: 24rpx; }
.order-status { flex-shrink: 0; color: #333; }
.order-status.serving { background: #e9f4df; color: #4d8029; padding: 2rpx 12rpx; border-radius: 6rpx; }
.order-status.pending { color: #b97b0d; background: #fff0ce; padding: 2rpx 12rpx; border-radius: 6rpx; }
.product-row { display: flex; align-items: flex-start; gap: 24rpx; padding: 24rpx 0; }
.product-image { width: 156rpx; height: 156rpx; flex-shrink: 0; border-radius: 12rpx; }
.product-placeholder { display: flex; align-items: center; justify-content: center; color: #b77d40; background: #fff1dc; }
.product-info { flex: 1; min-width: 0; }
.order-name { display: block; color: #111; font-size: 28rpx; font-weight: 600; overflow-wrap: anywhere; }
.price-row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; color: #999; font-size: 24rpx; border-bottom: 1rpx solid #e9e5e0; }
.order-price { color: #da4a44; font-size: 34rpx; font-weight: 700; }
.product-note { display: block; padding-top: 12rpx; color: #888; font-size: 24rpx; line-height: 1.65; overflow-wrap: anywhere; }
.order-fields { border-top: 1rpx solid #e9e5e0; padding-top: 14rpx; }
.field-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; padding: 10rpx 0; font-size: 26rpx; line-height: 1.65; }
.field-label { flex-shrink: 0; color: #999; }
.field-value { min-width: 0; flex: 1; text-align: right; overflow-wrap: anywhere; }
.order-number { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 「复制」按钮：内置 button 自带定宽，只写 flex-shrink:0 压不住，会被撑成整行 ——
   跟 orders / order-detail 两页同一套 min/max 封印 + 同一个尺寸（116rpx × 48rpx），
   现在一行放两个以上的复制钮也不会互相挤。配色仍是打手端自己的橙。 */
.main-container .copy-button { flex: 0 0 auto; width: 116rpx; min-width: 116rpx; max-width: 116rpx; height: 48rpx; min-height: 48rpx; max-height: 48rpx; margin: 0; padding: 0; border: 1rpx solid #eca554; border-radius: 6rpx; background: #fff8ed; color: #a9741f; font-size: 24rpx; line-height: 46rpx; box-sizing: border-box; }
.income-row { padding: 18rpx 0; }
.income { color: #da4a44; font-size: 28rpx; font-weight: 700; }
.order-actions { display: flex; align-items: stretch; gap: 12rpx; border-top: 1rpx solid #e9e5e0; padding-top: 20rpx; }
.main-container .order-actions button { flex: 1; width: 0; min-width: 0; padding: 14rpx 8rpx; min-height: 64rpx; background: #ff8800; color: #fff; font-size: 22rpx; display: flex; align-items: center; justify-content: center; }
.main-container .order-actions .secondary-button { background: #fff1df; color: #ad520b; }
.main-container .order-actions button[disabled] { background: #f7e4d1; color: #956440; }
.state-message { padding: 48rpx 24rpx; font-size: 26rpx; color: #888; text-align: center; }
.list-end { padding: 36rpx; color: #aaa; text-align: center; }
.error-card { margin: 24rpx; padding: 24rpx; background: #fff; border-radius: 20rpx; color: #b45309; text-align: center; }
.error-card button { padding: 16rpx; margin-top: 16rpx; }
.main-container .conversation-row { display: flex; align-items: center; width: calc(100% - 48rpx); gap: 24rpx; margin: 0 24rpx 16rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; text-align: left; }
.conversation-avatar { width: 88rpx; height: 88rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: #fff0da; color: #bd681b; border-radius: 24rpx; position: relative; font-size: 32rpx; }
.conversation-info { flex: 1; min-width: 0; }
.conversation-info text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #777; font-size: 24rpx; }
.conversation-info .order-name { color: #333; font-size: 28rpx; margin-bottom: 6rpx; }
.conversation-info .conversation-no { color: #aaa; font-size: 20rpx; }
.unread-badge { position: absolute; right: -10rpx; top: -10rpx; border-radius: 30rpx; padding: 2rpx 8rpx; color: #fff; background: #f97316; font-size: 20rpx; }
.player-tabbar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 30; display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); padding: 14rpx 12rpx calc(14rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #f2e7da; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,.04); }
.main-container .player-tab { display: flex; flex-direction: column; align-items: center; gap: 10rpx; width: 100%; min-width: 0; max-width: 100%; background: transparent; border-radius: 14rpx; padding: 8rpx 0; font-size: 20rpx; color: #9a704c; white-space: nowrap; }
.main-container .player-tab.active { background: #fff4e7; color: #f58215; font-weight: 600; }
.tab-icon-wrap { position: relative; display: flex; align-items: center; justify-content: center; height: 38rpx; width: 42rpx; }
.unread-dot { width: 12rpx; height: 12rpx; border-radius: 50%; position: absolute; right: -4rpx; top: 0; background: #f97316; }
.nav-icon { width: 32rpx; height: 30rpx; border: 3rpx solid currentColor; border-radius: 6rpx; position: relative; }
.nav-icon::before,.nav-icon::after { content: ""; position: absolute; box-sizing: border-box; }
.icon-hall::before { width: 16rpx; height: 10rpx; border: 3rpx solid currentColor; border-bottom: 0; top: -11rpx; left: 5rpx; border-radius: 5rpx 5rpx 0 0; }
.icon-orders::before,.icon-notice::before { width: 16rpx; height: 3rpx; background: currentColor; left: 5rpx; top: 7rpx; box-shadow: 0 9rpx 0 currentColor; }
.icon-chat { border-radius: 12rpx; }
.icon-chat::after { width: 8rpx; height: 8rpx; border-left: 3rpx solid currentColor; bottom: -7rpx; left: 5rpx; transform: skewY(-30deg); }
.icon-wallet::after { width: 12rpx; height: 12rpx; border: 3rpx solid currentColor; right: -5rpx; top: 6rpx; border-radius: 3rpx; background: #fff; }
.icon-person,.icon-people { border-radius: 50% 50% 6rpx 6rpx; height: 18rpx; margin-top: 16rpx; }
.icon-person::before,.icon-people::before { width: 18rpx; height: 18rpx; border: 3rpx solid currentColor; border-radius: 50%; left: 4rpx; top: -21rpx; background: #fff; }
.icon-people::after { width: 8rpx; height: 20rpx; border-right: 3rpx solid currentColor; right: -10rpx; top: -3rpx; border-radius: 50%; }
.icon-star { transform: rotate(45deg); border-radius: 4rpx; width: 26rpx; height: 26rpx; }
.icon-star::before { inset: 5rpx; border: 2rpx solid currentColor; }
.icon-ranking { border: 0; border-bottom: 3rpx solid currentColor; border-radius: 0; }
.icon-ranking::before { width: 7rpx; height: 26rpx; bottom: 0; left: 12rpx; background: currentColor; box-shadow: -11rpx 10rpx 0 currentColor,11rpx 6rpx 0 currentColor; }
.icon-switch { border: 0; border-top: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; height: 20rpx; border-radius: 0; }
.icon-switch::before { right: 0; top: -6rpx; width: 8rpx; height: 8rpx; border-top: 3rpx solid currentColor; border-right: 3rpx solid currentColor; transform: rotate(45deg); }
.icon-switch::after { left: 0; bottom: -6rpx; width: 8rpx; height: 8rpx; border-bottom: 3rpx solid currentColor; border-left: 3rpx solid currentColor; transform: rotate(45deg); }
.icon-settings { border-radius: 50%; }
.icon-settings::before { inset: 6rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.identity-popup-mask,.chat-mask { position: fixed; inset: 0; z-index: 80; display: flex; align-items: flex-end; background: rgba(0,0,0,.5); }
.identity-popup { width: 100%; padding: 32rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 48rpx 48rpx 0 0; }
.identity-popup-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; }
.identity-popup-title { font-size: 36rpx; font-weight: 700; }
.main-container .close-button { width: 56rpx; height: 56rpx; min-width: 56rpx; border-radius: 50%; font-size: 38rpx; line-height: 56rpx; color: #b45309; background: #fff1df; }
.main-container .identity-option { width: 100%; margin-top: 20rpx; padding: 28rpx 24rpx; border: 2rpx solid #f2d3af; border-radius: 28rpx; text-align: left; background: #fff8f0; }
.main-container .identity-option.active { border-color: #ff8800; }
.identity-option > text { display: block; font-size: 30rpx; }
.identity-option .identity-desc { margin-top: 8rpx; color: #916440; font-size: 24rpx; }
.chat-sheet,.detail-sheet { width: 100%; max-height: 85vh; display: flex; flex-direction: column; overflow: hidden; border-radius: 28rpx 28rpx 0 0; background: #fff; padding-bottom: env(safe-area-inset-bottom); }
.chat-head,.chat-form { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; }
.chat-head { justify-content: space-between; border-bottom: 1rpx solid #eee; }
.chat-head > view { flex: 1; min-width: 0; }
.chat-head text { display: block; overflow-wrap: anywhere; font-size: 28rpx; }
.chat-head text + text { font-size: 22rpx; color: #999; }
.chat-messages { height: 52vh; padding: 24rpx; background: #f7f7f7; }
.chat-message { max-width: 82%; margin-bottom: 20rpx; }
.chat-message.mine { margin-left: auto; text-align: right; }
.chat-message .sender,.chat-message .read-state { display: block; color: #999; font-size: 20rpx; }
.chat-message view { margin: 8rpx 0; padding: 18rpx 22rpx; border-radius: 18rpx; background: #fff; line-height: 1.65; text-align: left; overflow-wrap: anywhere; }
.chat-message.mine view { background: #fff0dc; }
.chat-form input { flex: 1; height: 76rpx; min-width: 0; padding: 0 24rpx; border-radius: 100rpx; background: #f6f6f6; }
.main-container .chat-form button { width: 120rpx; min-height: 76rpx; flex-shrink: 0; border-radius: 100rpx; color: #fff; background: #ff8800; }
.main-container .chat-form button[disabled] { background: #f7e4d1; color: #956440; }
.detail-body { height: 58vh; padding: 28rpx; }
.detail-title { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }
.detail-hint { display: block; font-size: 24rpx; color: #999; margin-top: 24rpx; }
