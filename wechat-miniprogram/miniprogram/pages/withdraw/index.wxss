/* 提现页（提现 / 提现资料 / 提现记录 三块视图）。视觉沿用打手工作台那套橙色卡片语言。 */
.wd-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(120rpx + env(safe-area-inset-bottom));
  color: #333;
  font-size: 26rpx;
  line-height: 1.8;
  background: linear-gradient(180deg, #fff6ec 0%, #f7f9fc 46%, #eef6ff 100%);
}

/* 按钮全部收成项目里的形状（全局 reset 把背景/圆角都清了）。 */
.wd-page button {
  width: auto;
  min-width: 0;
  max-width: 100%;
  margin: 0;
  border: none;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  color: #a94f0a;
  background: #fff0dc;
  font-size: 24rpx;
  line-height: 1.6;
}
.wd-page button::after { border: none; }
.wd-page button[disabled] { color: #956843; background: #f5e5d5; opacity: .8; }

.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, .04);
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card-title {
  display: block;
  border-bottom: 1rpx solid rgba(0, 0, 0, .08);
  color: #000;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
}

/* —— 提现金额 —— */
.amount-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.balance-hint { color: #666; font-size: 26rpx; }
.text-link { background: transparent; padding: 0; color: #c56416; font-size: 24rpx; }
.amount-input-wrap { display: flex; align-items: center; height: 96rpx; padding: 0 24rpx; border-radius: 16rpx; background: rgba(0, 0, 0, .05); margin-bottom: 24rpx; }
.amount-symbol { color: #333; font-size: 32rpx; }
.amount-input { flex: 1; width: 0; min-width: 0; height: 96rpx; font-size: 32rpx; }
.min-amount-tip { color: #b36b10; font-size: 24rpx; margin-bottom: 24rpx; }
.commission-detail { background: linear-gradient(135deg, #fef3e8, #fff7f0); border: 1rpx solid rgba(230, 130, 30, .2); border-radius: 16rpx; margin-bottom: 20rpx; padding: 20rpx 24rpx; }
.commission-row { display: flex; justify-content: space-between; align-items: center; padding: 6rpx 0; color: #8b6914; }
.actual-row { border-top: 1rpx dashed rgba(230, 130, 30, .25); margin-top: 8rpx; padding-top: 12rpx; }
.actual-value { color: #547b31; font-size: 30rpx; }
.card-actions { display: flex; gap: 12rpx; border-top: 1rpx solid rgba(0, 0, 0, .08); padding-top: 16rpx; }
.card-actions button { flex: 1; width: 0; min-height: 64rpx; font-size: 24rpx; }

/* —— 提现方式（横排三个渠道）—— */
.channel-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; }
.channel-item { width: 100%; min-height: 108rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; border: 1rpx solid #f0dcc6; background: #fffaf5; }
.channel-item.active { border-color: #ff8800; background: #fff1e0; }
.channel-label { font-size: 26rpx; }
.channel-closed { font-size: 20rpx; color: #999; }
.channel-item.is-disabled { opacity: .55; }

/* —— 说明文案（商户后台可覆盖，默认三段）—— */
.notice-text { display: block; color: #666; font-size: 26rpx; line-height: 1.9; white-space: pre-wrap; }

.btn-submit { width: 100%; min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #ff8800; color: #fff; font-size: 30rpx; }
.btn-submit[disabled] { background: #f0d3b4; color: #fff; opacity: 1; }
.back-link { width: 100%; margin-top: 24rpx; background: transparent; color: #a96228; font-size: 26rpx; }
.wd-error { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 32rpx 0; color: #c0392b; }

/* —— 提现资料 —— */
.tabs-row { display: flex; gap: 12rpx; border-radius: 16rpx; padding: 16rpx; background: #fff; margin-bottom: 24rpx; }
.tabs-row .method-tab { flex: 1; width: 0; min-width: 0; max-width: 100%; padding: 16rpx 0; font-size: 24rpx; white-space: nowrap; }
.tabs-row .method-tab.active { background: #ff8800; color: #fff; }
.form-row { border-bottom: 1rpx solid #eee; padding-bottom: 24rpx; margin-bottom: 24rpx; }
.form-label { display: block; font-size: 24rpx; margin-bottom: 16rpx; color: #333; }
.form-input { width: 100%; height: 80rpx; padding: 0 24rpx; border-radius: 12rpx; background: #f5f5f5; font-size: 26rpx; }
.form-section { padding-bottom: 8rpx; }
.qr-upload-wrap { display: flex; align-items: center; justify-content: center; width: 280rpx; height: 280rpx; border-radius: 16rpx; overflow: hidden; background: #f5f5f5; }
.qr-image { width: 280rpx; height: 280rpx; }
.qr-placeholder-text { font-size: 26rpx; color: #999; }

/* —— 提现记录 —— */
.record-list { display: flex; flex-direction: column; gap: 20rpx; }
.record-row { background: #fff; border-radius: 24rpx; box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, .04); padding: 24rpx 28rpx; }
.record-line { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.record-channel { font-size: 28rpx; font-weight: 600; }
.record-detail { display: block; color: #666; font-size: 24rpx; }
.record-time { display: block; color: #999; font-size: 22rpx; }
.record-amount { display: block; color: #c56416; font-size: 28rpx; font-weight: 700; }
/* 状态标签按 `status-{status}` 上色（文档第九节指定类名）。 */
.record-status { border-radius: 20rpx; font-size: 22rpx; padding: 6rpx 18rpx; flex-shrink: 0; }
.status-pending { background: #fff5e7; color: #b36b10; }
.status-approved { background: #eff8e8; color: #508628; }
.status-rejected { background: #fff2f0; color: #c0392b; }

.state-message { padding: 64rpx 20rpx; text-align: center; color: #7a8798; font-size: 25rpx; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 96rpx 20rpx; color: #777; font-size: 28rpx; }
.list-end { padding: 32rpx 0 8rpx; text-align: center; color: #a9b2be; font-size: 24rpx; }
