/* 「我的」页：顶部渐变会员卡 → 数字卡 → 累计消费 → 功能宫格 → 底部 tab。
   不保留「我的订单」「下单说明」「联系客服」。 */
.mine-page { background: linear-gradient(180deg, #edf6ff 0%, #f8fafc 42%, #fff9df 100%); }

.mine-hero { padding: 36rpx; margin-bottom: 24rpx; border-radius: 24rpx; background: linear-gradient(135deg, #ffe9a8 0%, #fff8e2 46%, #d9eeff 100%); box-shadow: 0 16rpx 36rpx rgba(31,41,55,.06); }

.mine-hero-head { display: flex; align-items: center; gap: 24rpx; }

.profile-avatar { width: 104rpx; height: 104rpx; flex: 0 0 104rpx; margin: 0; padding: 0; border-radius: 50%; color: #151515; background: #fff; font-size: 40rpx; font-weight: 900; line-height: 104rpx; text-align: center; overflow: hidden; }
.profile-avatar image { width: 100%; height: 100%; border-radius: 50%; }

.mine-hero-who { flex: 1; min-width: 0; }
.mine-hero-name { display: block; color: #172033; font-size: 40rpx; font-weight: 900; }
.mine-hero-id { display: block; margin-top: 8rpx; color: #6b7280; font-size: 24rpx; }
.mine-hero-tip { display: block; margin-top: 24rpx; color: #6b4e16; font-size: 24rpx; line-height: 1.5; }

.member-badge { width: max-content; padding: 8rpx 18rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 900; }
.member-badge.gold { color: #6b4100; background: linear-gradient(135deg, #fff4b8, #fbbf24); }
.member-badge.platinum { color: #304055; background: linear-gradient(135deg, #f8fafc, #b8c6d9); }
.member-badge.diamond { color: #075985; background: linear-gradient(135deg, #e0f7ff, #7dd3fc); }
.member-badge.blackgold { color: #f8e7a2; background: linear-gradient(135deg, #171717, #6b4e16); }

.mine-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; margin-bottom: 24rpx; padding: 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 16rpx 36rpx rgba(31,41,55,.06); }

.mine-stat { width: 100%; min-width: 0; max-width: 100%; display: grid; align-content: center; gap: 8rpx; justify-items: center; min-height: 104rpx; padding: 12rpx 4rpx; margin: 0; border: 0; border-right: 2rpx solid #edf0f3; border-radius: 0; color: #172033; background: transparent; text-align: center; box-sizing: border-box; }
.mine-stat:last-child { border-right: 0; }
.mine-stat-value { color: #0f766e; font-size: 36rpx; font-weight: 900; line-height: 1.2; }
.mine-stat-label { color: #8a95a5; font-size: 24rpx; }
/* 累计消费：用户要求从三栏卡里拎出来，单独成一条放在会员等级后面（网页 .mine-spent 的镜像，值 ×2）。 */
.mine-spent { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 28rpx 32rpx; margin: 0 0 24rpx; border: 0; border-radius: 24rpx; background: #fff; box-shadow: 0 16rpx 36rpx rgba(31,41,55,.06); box-sizing: border-box; text-align: left; }
.mine-spent-label { color: #6b7280; font-size: 26rpx; }
.mine-spent-value { color: #0f766e; font-size: 36rpx; font-weight: 900; }

.mine-functions { padding: 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 16rpx 36rpx rgba(31,41,55,.06); }
.mine-functions-head { display: flex; align-items: center; margin-bottom: 16rpx; }
.mine-functions-head text { color: #172033; font-size: 28rpx; font-weight: 900; }
/* ⚠️ 必须写 minmax(0, 1fr)，不能写 1fr。`1fr` 等价于 `minmax(auto, 1fr)`，而 auto 下限 = 条目的
   min-content 宽度；小程序内置 <button> 自带一个定宽（约 184px = 368rpx），于是每一列都被顶到 368rpx，
   4 列 = 1472rpx + 间距，远超卡片可用的 ~654rpx → 整行溢出卡片、后两列被推到屏幕右侧外面看不见。
   2026-09-15 用户截图反馈「打手跟老板之前的身份切换去哪了」就是这么来的：身份切换（第 3 格）和
   进入工作台（第 4 格）其实都渲染了，只是被推出可视区，屏幕上只剩前两列。
   同类约定：首页 .product-grid 用 repeat(N, minmax(0, 1fr))、.notice-links button 写 width/min-width。 */
.mine-fn-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; }

/* 内置 button 定宽封印：width/min-width/max-width 三处都写死，min-width: 0 才能让它在 1fr 列里被压缩。
   少了 min-width: 0，列宽仍会被内置宽度顶开；少了 width: 100%，按钮不会铺满自己的格子。 */
.mine-fn { width: 100%; min-width: 0; max-width: 100%; display: grid; align-content: center; gap: 12rpx; justify-items: center; min-height: 136rpx; padding: 16rpx 4rpx; margin: 0; border: 0; border-radius: 16rpx; color: #334155; background: #f8fafc; box-sizing: border-box; }
.mine-fn-icon { display: grid; place-items: center; width: 68rpx; height: 68rpx; border-radius: 50%; color: #0f766e; background: #e6f4f1; font-size: 34rpx; line-height: 1; }
.mine-fn-label { color: #334155; font-size: 24rpx; line-height: 1.3; }
.mine-fn-meta { color: #8a95a5; font-size: 20rpx; line-height: 1.2; }

.benefit-mask { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; padding: 28rpx; background: rgba(15,23,42,.45); box-sizing: border-box; }
.benefit-sheet { width: 100%; max-height: 78vh; overflow: hidden; border-radius: 28rpx; background: #fff; box-shadow: 0 36rpx 88rpx rgba(15,23,42,.24); }
.benefit-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 24rpx; border-bottom: 1rpx solid #e5edf5; }
.benefit-head text { display: block; }.benefit-head text:first-child { color: #172033; font-size: 32rpx; font-weight: 800; }.benefit-head text:last-child { margin-top: 4rpx; color: #64748b; font-size: 22rpx; }
.benefit-head button { width: 58rpx; height: 58rpx; min-height: 58rpx; padding: 0; border-radius: 50%; background: #f1f5f9; line-height: 58rpx; }
.benefit-list { max-height: 60vh; padding: 22rpx; background: #f8fafc; box-sizing: border-box; }
.benefit-item { display: grid; gap: 10rpx; margin-bottom: 18rpx; padding: 22rpx; border: 1rpx solid #fde68a; border-radius: 18rpx; background: #fff; text-align: left; }
.benefit-item.active { border-color: #0ea5a8; box-shadow: inset 0 0 0 1rpx #0ea5a8; }
.benefit-level { color: #92400e; font-size: 30rpx; font-weight: 800; }.benefit-condition { color: #0f766e; font-size: 22rpx; font-weight: 700; }.benefit-copy { color: #334155; line-height: 1.6; white-space: pre-wrap; }
