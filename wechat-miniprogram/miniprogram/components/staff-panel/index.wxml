<view class="panel-page mode-{{mode}}">
  <view class="navbar"><text class="navbar-title">{{title}}</text></view>
  <view class="integration-notice"><text>部分业务暂未接通</text><text>资金指标、保证金、罚单、佣金流水、管事功能与排行榜已接通；陪玩等级、客服等仍未接通，不显示虚构数据。</text></view>

  <block wx:if="{{mode === 'center'}}">
    <view class="section auth-section">
      <view class="auth-header"><text class="section-title">接单授权</text><text class="auth-status-badge {{profile.granted ? 'auth-status-active' : 'auth-status-inactive'}}">{{profile.granted ? '已开通' : '未确认'}}</text></view>
      <view class="auth-content"><view class="auth-detail"><text class="auth-label">打手昵称</text><text class="auth-value">{{profile.name}}</text></view><view class="auth-detail"><text class="auth-label">用户ID</text><text class="auth-value">{{profile.numericId || '—'}}</text></view><text class="muted-note">打手授权仍由商户后台开通；管事邀请码在下面「管事功能」里兑换。</text></view>
    </view>
    <view class="section parent-section">
      <text class="section-title">上级管事</text>
      <block wx:if="{{steward.superior}}">
        <text class="muted-note">你的上级管事：{{steward.superior.displayName}}（ID {{steward.superior.numericId || '—'}}）</text>
        <text class="muted-note">你提现时，商户按 {{withdrawFeeText}} 收取提现手续费。</text>
        <button class="outline-button" disabled>联系上级 · 暂未接通</button>
      </block>
      <text wx:elif="{{steward.isSteward}}" class="muted-note">你是商户直接开通的管事，没有上级管事。</text>
      <text wx:else class="muted-note">还没有绑定上级管事。输入管事邀请码即可加入。</text>
    </view>
    <view class="section manager-section">
      <text class="section-title">管事功能</text>
      <block wx:if="{{steward.isSteward}}">
        <view class="steward-code-row"><text class="muted-note">我的邀请码（长期有效，可反复使用）</text><text class="steward-code">{{steward.myCode || '生成中…'}}</text></view>
        <view class="manager-actions"><button bindtap="generate">生成邀请码</button><button bindtap="copyCode">复制我的邀请码</button></view>
        <text class="muted-note">把邀请码发给打手，他输入后就成为你的下级打手。</text>
      </block>
      <block wx:else>
        <text class="muted-note">输入商户发给你的管事邀请码，即可升级为管事。</text>
        <button class="wide-button" bindtap="redeem">输入邀请码成为管事</button>
      </block>
      <button class="wide-button" data-target="subordinates" bindtap="navigate">查看下级打手 ›</button>
    </view>
    <view class="section my-bill"><view class="section-header"><text class="section-title">我的资金</text><button class="text-link" data-target="balanceLog" bindtap="navigate">余额明细 ›</button></view><view class="bill-list"><button wx:for="{{fundGrid}}" wx:key="key" class="bill-item" data-target="{{item.target}}" bindtap="navigate"><text class="bill-num {{item.warn ? 'bill-num-warn' : ''}}">{{item.value}}</text><text class="bill-label">{{item.label}}</text></button></view><text class="muted-note">保证金 / 可用佣金 / 冻结佣金是三本独立的账：打手上传结单截图后佣金先冻结，商户结单才转成可用佣金，也只有可用佣金能提现。</text></view>
    <view class="section level-info-section"><text class="section-title">陪玩等级信息</text><view class="level-info-row">我的服务评分：—</view><view class="level-info-row">陪玩类型：—</view><view class="level-info-row">我的陪玩等级：—</view><view class="level-info-row">等级到期时间：—</view><text class="muted-note">等级数据尚未接通。</text></view>
  </block>

  <block wx:elif="{{mode === 'bound'}}">
    <view class="card card-glass balance-card"><view class="balance-row"><text class="balance-label">当前保证金</text><text class="balance-num">{{bondText}}</text><text class="balance-unit">元</text></view></view>
    <view class="card card-glass amount-card">
      <view class="card-title">选择充值金额</view>
      <view class="amount-grid">
        <button wx:for="{{bondTiers}}" wx:key="amount" class="amount-item {{bondPick === item.amount && !bondCustom ? 'active' : ''}}" data-amount="{{item.amount}}" bindtap="pickBondTier">
          <text class="amount-value">{{item.label}}</text>
          <text class="amount-desc">{{item.recommended ? '推荐' : '　'}}</text>
        </button>
      </view>
      <view class="bond-custom-row">
        <text class="bond-custom-label">自定义金额</text>
        <input class="bond-custom-input" type="digit" value="{{bondCustom}}" placeholder="输入其他金额" bindinput="inputBond" />
        <text class="bond-custom-unit">元</text>
      </view>
      <text class="muted-note">保证金只增不减；平台不会扣减、解冻或退还保证金。</text>
    </view>
    <button class="btn-submit" bindtap="submitBond" loading="{{bondSubmitting}}" disabled="{{bondSubmitting}}">{{bondSubmitting ? '提交中…' : '确定充值'}}</button>
  </block>

  <block wx:elif="{{mode === 'fine'}}">
    <view class="tabs-wrap"><button wx:for="{{fineTabs}}" wx:key="status" class="tab-item {{fineTab === index ? 'active' : ''}}" data-index="{{index}}" bindtap="chooseFineTab">{{item.label}}</button></view>
    <view wx:if="{{fineRows.length}}" class="fine-list">
      <view wx:for="{{fineRows}}" wx:key="fine_no" class="fine-row">
        <view class="fine-row-head">
          <text class="fine-reason">{{item.reason}}</text>
          <text class="fine-amount">¥ {{item.amount_text}}</text>
        </view>
        <view class="fine-meta"><text>罚单号 {{item.fine_no}}</text><text class="fine-status {{item.status_class}}">{{item.status_text}}</text></view>
        <view class="fine-meta"><text>开单时间 {{item.fine_time_text || '—'}}</text></view>
        <view wx:if="{{item.pay_time_text}}" class="fine-meta"><text>缴纳时间 {{item.pay_time_text}}</text></view>
        <view wx:if="{{item.order_no}}" class="fine-meta"><text>关联订单 {{item.order_no}}</text></view>
        <view wx:if="{{item.punish_text}}" class="fine-punish"><text>{{item.punish_text}}</text></view>
        <button wx:if="{{item.payable}}" class="btn-submit fine-pay" data-index="{{index}}" bindtap="payFine" loading="{{payingIndex === index}}" disabled="{{payingIndex > -1}}">{{payingIndex === index ? '缴纳中…' : '立即缴纳'}}</button>
      </view>
    </view>
    <view wx:else class="empty-state"><view class="empty-symbol">—</view><text>{{fineEmpty}}</text><text class="muted-note">{{finesLoading ? '加载中…' : '当前筛选下没有罚单'}}</text></view>
    <view wx:if="{{fineRows.length}}" class="list-foot">
      <text>待缴合计 ¥ {{finesUnpaid}}</text>
      <text wx:if="{{!finesEnded}}" class="text-link" bindtap="moreFines">加载更多</text>
      <text wx:elif="{{finesEnded}}">{{fineEnd}}</text>
    </view>
  </block>

  <block wx:elif="{{mode === 'balanceLog'}}">
    <view class="header-card"><view class="header-content"><view class="money-item money-item-center"><text class="money-label">可用佣金</text><text class="money-value">¥ {{headerSums.available}}</text></view><view class="money-row money-row-bottom"><view class="money-item"><text class="money-label">冻结佣金</text><text class="money-value money-income">¥ {{headerSums.frozen}}</text></view><view class="money-item"><text class="money-label">累计结算</text><text class="money-value money-withdraw">¥ {{headerSums.settled}}</text></view></view></view></view>
    <view class="tabs-wrap"><button wx:for="{{commissionTabs}}" wx:key="key" class="tab-item {{commissionTab === index ? 'active' : ''}}" data-index="{{index}}" bindtap="chooseCommissionTab">{{item.label}}</button></view>
    <view wx:if="{{commissionRows.length}}" class="log-list">
      <view wx:for="{{commissionRows}}" wx:key="rowKey" class="log-row">
        <view class="log-main">
          <text class="log-type">{{item.type_text}}</text>
          <text class="log-time">{{item.time_text}}</text>
        </view>
        <view class="log-side">
          <text class="log-amount amount-{{item.direction}}">{{item.amount_text}}</text>
          <text class="log-after">余额 {{item.available_after_text}}</text>
        </view>
        <view wx:if="{{item.goods_name}}" class="log-extra"><text>{{item.goods_name}}</text></view>
        <view wx:if="{{item.fine_reason}}" class="log-extra"><text>{{item.fine_reason}}</text></view>
      </view>
    </view>
    <view wx:else class="empty-state"><view class="empty-symbol">—</view><text>{{commissionEmpty}}</text><text class="muted-note">{{commissionLoading ? '加载中…' : '当前筛选下没有流水'}}</text></view>
    <view wx:if="{{commissionRows.length}}" class="list-foot">
      <text wx:if="{{!commissionEnded}}" class="text-link" bindtap="moreCommission">加载更多</text>
      <text wx:elif="{{commissionEnded}}">{{commissionEnd}}</text>
    </view>
  </block>

  <block wx:elif="{{mode === 'subordinates'}}"><view class="stats-card"><view class="stat-item"><text class="stat-value">{{steward.subordinates.length}}</text><text class="stat-label">下级总数</text></view><view class="stat-item"><text class="stat-value">{{steward.isSteward ? '已开通' : '—'}}</text><text class="stat-label">管事身份</text></view><view class="stat-item"><text class="stat-value">{{steward.superior ? '已绑定' : '—'}}</text><text class="stat-label">上级管事</text></view></view><view class="list-header">下级列表</view><view wx:if="{{steward.subordinates.length}}" class="subordinate-list"><view wx:for="{{steward.subordinates}}" wx:key="numericId" class="subordinate-row"><view class="subordinate-main"><text class="subordinate-name">{{item.displayName}}</text><text class="subordinate-id">ID {{item.numericId || '—'}}</text></view><text class="subordinate-code">邀请码 {{item.code}}</text></view></view><view wx:else class="empty-state"><view class="empty-symbol">—</view><text>{{steward.isSteward ? '还没有下级打手' : '你还不是管事，暂时没有下级'}}</text><text class="muted-note">把「我的邀请码」发给打手，他输入后就会出现在这里。</text></view></block>
  <block wx:elif="{{mode === 'ranking'}}">
    <view class="ranking-head"><text class="section-title">接单排行榜</text><text class="muted-note">与后台「员工管理 / 排行榜」口径一致：按接单笔数排序，仅显示前 20 名</text></view>
    <view wx:if="{{rankingLoading}}" class="empty-state"><view class="empty-symbol">—</view><text>加载中…</text></view>
    <view wx:elif="{{rankingError}}" class="empty-state"><view class="empty-symbol">!</view><text>{{rankingError}}</text></view>
    <view wx:elif="{{rankingRows.length}}" class="ranking-list">
      <view wx:for="{{rankingRows}}" wx:key="rank" class="ranking-row {{item.rank <= 3 ? 'ranking-top' : ''}}">
        <view class="ranking-rank"><text wx:if="{{item.medal}}" class="ranking-medal">{{item.medal}}</text><text wx:else class="ranking-num">{{item.rank}}</text></view>
        <view class="ranking-info">
          <text class="ranking-name">{{item.name}}</text>
          <text wx:if="{{item.numericId}}" class="ranking-id">ID {{item.numericId}}</text>
        </view>
        <view class="ranking-stat">
          <text class="ranking-count">{{item.orderCount}} 单</text>
          <text class="ranking-amount">¥ {{item.orderAmount}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty-state"><view class="empty-symbol">—</view><text>暂无排行榜数据</text></view>
  </block>
  <view wx:else class="empty-state"><view class="empty-symbol">—</view><text>{{title}}尚未接通</text><text class="muted-note">功能入口已保留，接通业务后启用。</text><button class="outline-button" bindtap="explain">查看说明</button></view>
</view>
